{#
	Bordered panel with an icon header, used to group lists and details.
	Panels with a heading collapse by clicking it; they start closed, so the page doesn't shift as it loads.
	A toggled state is remembered per kind of page (not per element) and panel (keyed by `id` or the heading) in local storage.
	Pass `collapsible: false` for panels holding filters, so they cannot be hidden.
	A description is shown in a popover, opened by an info button next to the heading.
	Collapsible panels hold their body only once loaded, so the page only renders their header, with what sums them up, and
	a placeholder in place of their body. Opened, they load their header and body from their page, requested with their
	`panelKey` as `panel`, which renders the panel alone, `loaded`, along with the scripts its body registers (see
	BaseController::renderPanel()); panels passed a URL as `lazy` load from it instead.

	Variables: heading, icon, color, description, count, id, panelKey (defaults to `id` or the heading), collapsible,
	loaded, lazy
	Blocks: actions (header end), body
#}
{% import 'hub/_components/macros' as hub %}

{% set collapsible = (heading ?? false) and (collapsible ?? true) %}
{% set headerTag = collapsible ? 'summary' : 'header' %}
{% set panelKey = panelKey ?? id ?? (heading ?? '')|kebab %}
{% set panelDeferred = collapsible and not (loaded ?? false) %}
{# The page of the URL, like that of a panel's pagination, is one of its path's segments in the CP, which Craft takes off it. #}
{% set panelPage = craft.app.request.pageNum > 1 ? '/p' ~ craft.app.request.pageNum : '' %}
{% set panelLazyUrl = panelDeferred ? (lazy ?? url(craft.app.request.pathInfo ~ panelPage, craft.app.request.queryParamsWithoutPath|merge({ panel: panelKey }))) : null %}
{% set panelRequested = collapsible and not panelDeferred and craft.app.request.getQueryParam('panel') == panelKey %}
{% set descriptionId = (heading ?? false) and (description ?? false) ? 'hub-panel-description-' ~ random() : null %}

<section class="hub-panel"{% if id ?? false %} id="{{ id }}"{% endif %}>
	{% if collapsible %}<details class="hub-panel__details" data-hub-panel="{{ panelKey }}"{% if panelLazyUrl %} data-hub-lazy="{{ panelLazyUrl }}"{% endif %}>{% endif %}

	{% if heading ?? false %}
		<{{ headerTag }} class="hub-panel__header">
			{% if icon ?? false %}
				{{ hub.icon(icon, color ?? 'gray') }}
			{% endif %}
			<div class="hub-panel__title">
				<h2>{{ heading }}</h2>
				{% if descriptionId %}
					<button type="button" class="hub-panel__info" popovertarget="{{ descriptionId }}" aria-label="{{ 'Info'|t('hub') }}" title="{{ 'Info'|t('hub') }}">{{ iconSvg('circle-info') }}</button>
				{% endif %}
			</div>
			{% block actions %}
				{% if (count ?? null) is not null %}
					<span class="hub-pill">{{ count|number }}</span>
				{% endif %}
			{% endblock %}
			{% if collapsible %}
				<span class="hub-panel__toggle" aria-hidden="true">{{ iconSvg('chevron-down') }}</span>
			{% endif %}
		</{{ headerTag }}>
	{% endif %}

	{% if panelDeferred %}
		<div class="hub-panel__loading" data-hub-lazy-status>
			<div class="spinner"></div>
		</div>
	{% elseif panelRequested %}
		{# The scripts the body registers run once it's loaded, see initLazy(). #}
		{% do view.startJsBuffer() %}
		{% block body %}{% endblock %}
		{{ view.clearJsBuffer()|raw }}
	{% else %}
		{{ block('body') }}
	{% endif %}

	{% if collapsible %}</details>{% endif %}

	{# Outside the header, so clicks within it do not toggle the panel. #}
	{% if descriptionId %}
		<div class="hub-panel__description" id="{{ descriptionId }}" popover data-hub-info>{{ description }}</div>
	{% endif %}
</section>

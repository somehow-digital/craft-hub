{#
	Panel with the filterable list of section and nested entries, on the entries page and on section, entry type and field pages.
	There can be many entries, so they are filtered, sorted and paginated on the server.
	Sections, nested entry fields and entry types are offered as far as they are used together; the one a detail page is limited to (`listFixed`), or its author, is neither offered nor shown.
	Pages can name what they limit it to by `fixedFilters` (see the `fixedFilters` macro), shown among the filters.
	The user filters offer `me` first, the user viewing the list, so saved filters list each user's own items.

	Variables: list (see BaseController::entryListVariables()), hubSite, fixedFilters
#}
{% import 'hub/_components/macros' as hub %}

{# Items can be labeled while there are labels, or the user can create some. #}
{% set labelable = list.canApplyLabels and (list.labels|length > 0 or list.canManageLabels) %}

{% set sectionOptions = {} %}
{% for info in list.sections %}
	{% set sectionType = enum('SomehowDigital\\Craft\\Hub\\enums\\SectionType').from(info.section.type) %}
	{% set sectionOptions = sectionOptions|merge({ (info.section.handle): { label: info.section.name|t('site'), icon: sectionType.icon(), color: sectionType.color() } }) %}
{% endfor %}

{% set fieldOptions = {} %}
{% for info in list.nestedFields %}
	{% set fieldOptions = fieldOptions|merge({ (info.field.handle): { label: info.field.name|t('site'), icon: info.field.getIcon() ?: 'pen-to-square', color: 'violet' } }) %}
{% endfor %}

{% set typeOptions = {} %}
{% for info in list.entryTypes %}
	{% set typeOptions = typeOptions|merge({ (info.entryType.handle): { label: info.entryType.name|t('site'), icon: info.entryType.icon ?: 'shapes', color: info.entryType.color.value ?? 'gray' } }) %}
{% endfor %}

{% embed 'hub/_components/panel' with {
	list: list,
	typeOptions: typeOptions,
	sectionOptions: sectionOptions,
	fieldOptions: fieldOptions,
	fixedFilters: fixedFilters ?? [],
	hubSite: hubSite,
	labelable: labelable,
} only %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<form method="get" class="hub-filters" action="{{ url(list.listPath) }}" data-hub-submit{% if list.bulkSelection.review ?? false %} hidden{% endif %}>
			{% include 'hub/_components/saved-filters' with { savedFilters: list.savedFilters, hubSite: hubSite } only %}
			{{ hub.search('Search by title or slug'|t('hub'), list.filter.search) }}
			{{ hub.fixedFilters(fixedFilters ?? []) }}
			{{ hub.dropdown('Status'|t('app'), 'circle-half-stroke', hub.choices('status', list.statuses|map((label, status) => { label: label, color: { live: 'green', pending: 'orange', expired: 'red' }[status] ?? 'gray' }), list.filter.statuses)) }}
			{% if list.listFixed != 'type' %}
				{{ hub.dropdown('Entry Type'|t('app'), 'shapes', hub.choices('type', typeOptions, list.filter.types)) }}
			{% endif %}
			{% if list.listFixed not in ['section', 'field'] and (list.sections|length or list.nestedFields|length) %}
				{# Choosing between section and nested entries only matters where there are both. #}
				{{ hub.dropdown('Origin'|t('hub'), 'diagram-nested', (list.sections|length and list.nestedFields|length ? hub.choices('origin', {
					section: { label: 'Section entries'|t('hub'), icon: 'layer-group', color: 'blue' },
					nested: { label: 'Nested entries'|t('hub'), icon: 'diagram-nested', color: 'violet' },
				}, list.filter.origin, { multiple: false, label: 'Origin'|t('hub') }) : '')
					~ (list.sections|length ? hub.choices('section', sectionOptions, list.filter.sections, { label: 'Sections'|t('app') }) : '')
					~ (list.nestedFields|length ? hub.choices('field', fieldOptions, list.filter.fields, { label: 'Nested entry fields'|t('hub') }) : '')) }}
			{% endif %}
			{% if list.listFixed != 'author' %}
				{{ hub.dropdown('Author'|t('app'), 'user', hub.choices('author', list.authorOptions, list.filter.authors, { lazy: list.optionsUrls.author })) }}
			{% endif %}
			{{ hub.dropdown('Last edited by'|t('hub'), 'user-pen', hub.choices('editor', list.editorOptions, list.filter.editors, { lazy: list.optionsUrls.editor })) }}
			{{ hub.dropdown('References'|t('hub'), 'link', hub.choices('usage', {
				referenced: { label: 'Referenced'|t('hub'), color: 'green' },
				unreferenced: { label: 'Unreferenced'|t('hub'), color: 'orange' },
			}, list.filter.usage, { multiple: false, label: 'Usage'|t('hub') })
				~ hub.range('references', 'Number of references'|t('hub'), list.filter.referencesMin, list.filter.referencesMax)) }}
			{{ hub.dropdown('Dates'|t('hub'), 'calendar', hub.range('posted', 'Post Date'|t('app'), list.filter.postedFrom, list.filter.postedTo, { type: 'date' })
				~ hub.range('updated', 'Last edited'|t('hub'), list.filter.updatedFrom, list.filter.updatedTo, { type: 'date' })) }}
			{{ hub.labelFilter(list.labelOptions, list.filter.labels) }}
			{{ hub.toggle('stale', 'Stale only'|t('hub'), list.filter.staleMonths is not null) }}
			{{ hub.toggle('drafts', 'With drafts only'|t('hub'), list.filter.drafts) }}
			{{ hub.toggle('myDrafts', 'With my drafts only'|t('hub'), list.filter.myDrafts) }}
			{{ hub.toggle('comingUp', 'Coming up only'|t('hub'), list.filter.comingUp) }}
			{{ hub.addFilter() }}
			{{ hiddenInput('sort', list.sort) }}
			{{ hiddenInput('dir', list.dir) }}
			{{ hiddenInput('selection', (list.bulkSelection.review ?? false) ? 1 : null) }}
			{{ hub.clearFilters() }}
		</form>

		{% if list.entries|length %}
			{% embed 'hub/_components/bulk' with { bulkList: 'entries', bulkNone: 'No entries selected'|t('hub'), list: list, labelable: labelable } only %}
				{% block table %}
					{% import 'hub/_components/macros' as hub %}
					<div class="hub-table">
						<table class="data fullwidth">
							<thead>
								<tr>
									{{ hub.bulkAll(list.bulkActions) }}
									{{ hub.sortHeader('Title'|t('app'), 'title', list.sortHeaders) }}
									{{ hub.columnHeaders(list.columns, list.sortHeaders, 'entries') }}
								</tr>
							</thead>
							<tbody>
								{% for entry in list.entries %}
									{% set references = list.referenceCounts[entry.id] ?? 0 %}
									<tr>
										{{ hub.bulkItem(list.bulkActions, entry.id, entry.title ?: entry.slug, null, entry.enabled ? (entry.enabledForSite ? ['enabled'] : []) : ['disabled']) }}
										<th>
											<div class="hub-name">
												{{ hub.itemIcon(entry.type) }}
												<div class="hub-name__text">
													<span class="hub-name__title"><a href="{{ hub.url(entry) }}">{{ hub.elementTitle(entry) }}</a>{{ hub.labels(list.itemLabels[entry.id] ?? [], entry.id, entry.title ?: entry.slug, labelable) }}</span>
													<code>{{ entry.slug }}</code>
												</div>
											</div>
										</th>
										{% for column in list.columns %}
											<td{{ hub.cellAttributes(column) }}>
												{%- if not column.visible -%}
												{%- elseif column.key == 'origin' -%}
													{% if entry.section %}{{ hub.chip(entry.section) }}{% elseif entry.field %}{{ hub.chip(entry.field, 'violet') }}{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'owner' -%}
													{% if entry.owner %}{{ hub.element(entry.owner) }}{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'creator' -%}
													{% if entry.authors|length %}<span class="hub-chips">{% for author in entry.authors %}{{ hub.user(author) }}{% endfor %}</span>{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'type' -%}
													{{ hub.chip(entry.type) }}
												{%- elseif column.key == 'status' -%}
													<span class="status {{ entry.status }}" aria-hidden="true"></span>{{ entry.statuses()[entry.status] ?? entry.status }}
												{%- elseif column.key == 'references' -%}
													{{ hub.num(references) }}
												{%- elseif column.key == 'posted' -%}
													{{ hub.date(entry.postDate) }}
												{%- elseif column.key == 'updated' -%}
													{{ hub.date(list.lastEdited[entry.id] ?? null) }}
												{%- elseif column.key == 'maintainers' -%}
													{{ hub.elementMaintainers(entry) }}
												{%- elseif column.key == 'url' -%}
													{{ hub.visit(entry, 'View entry'|t('hub')) }}
												{%- elseif column.key == 'edit' -%}
													{%- if entry.canView(currentUser) -%}
														{%- set label = 'Edit entry'|t('hub') -%}
														<a class="hub-visit" href="{{ entry.cpEditUrl }}" title="{{ label }}" aria-label="{{ label }}">{{ iconSvg('pen') }}</a>
													{%- endif -%}
												{%- endif -%}
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endblock %}
				{% block footer %}
					{% include '_includes/pagination' with {
						pageInfo: list.pageInfo,
						itemLabel: 'entry'|t('app'),
						itemsLabel: 'entries'|t('app'),
					} only %}
				{% endblock %}
			{% endembed %}
		{% else %}
			{{ hub.emptyList(list.bulkSelection ?? null) }}
		{% endif %}
	{% endblock %}
{% endembed %}

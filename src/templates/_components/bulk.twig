{#
	Form around the table of a list, whose rows are selected for bulk actions: by their checkbox, or by clicking them,
	shift selecting a range and ctrl or cmd adding to the selection.
	Without actions, the user can change none of the items, so the rows aren't selectable either.
	The table starts its header row with `hub.bulkAll(bulkActions)` and its rows with `hub.bulkItem(bulkActions, id, name)`.

	Lists with a `bulkSelection` (see BaseController::bulkVariables()) keep it on the server, so it survives filtering,
	sorting and paging through them. Their bar offers to select or unselect the page and all items matching the filters,
	and to review the selection: the list then shows only the selected items, whatever the filters, and offers the actions
	in their place, which apply to all of them.
	Other lists, like the transforms of a file, select the rows of their page only, offering the actions in a menu.
	Labeling (see BulkService::getActions()) opens the labels of the selection (see the `bulkLabels` macro) to pick the
	labels to add and remove first.

	Right-clicking a row opens its context menu: opening it in a new tab, selecting it, the actions, applied to that item
	only, and the labels, checked as the item is labeled with them (see the `labels` macro). Shift-right-clicking a row
	keeps the browser's own menu.

	Variables: bulkActions (see BulkService::getActions()), bulkSelection, bulkList, bulkNone (the label while none is
	selected), pageInfo (of a paginated list), bulkAction and bulkParams, for actions of other controllers than BulkController
	Blocks: table, footer (e.g. the pagination, before the bulk bar)
#}
{% import 'hub/_components/macros' as hub %}
{% set selectable = bulkActions|length > 0 %}
{% set selection = selectable ? bulkSelection ?? null : null %}
{% set review = selection.review ?? false %}

{% if selectable %}
	<form method="post" accept-charset="UTF-8" data-hub-bulk
		{%- if selection %} data-hub-bulk-list="{{ bulkList }}" data-hub-bulk-path="{{ selection.path }}" data-hub-bulk-selected="{{ selection.ids|json_encode }}" data-hub-bulk-outside="{{ selection.outside }}" data-hub-bulk-limit="{{ selection.limit }}"{% endif %}
		{%- if review %} data-hub-bulk-review{% endif %}>
		{{ csrfInput() }}
		{{ actionInput(bulkAction ?? 'hub/bulk/apply') }}
		{{ redirectInput(craft.app.request.url) }}
		{% for name, value in bulkParams ?? { list: bulkList, path: selection.path ?? null } %}
			{{ hiddenInput(name, value) }}
		{% endfor %}
{% endif %}

{% if review %}
	{# In place of the filters, which don't apply while reviewing. #}
	<div class="hub-filters hub-bulk__review">
		<span class="hub-bulk__review-icon" aria-hidden="true">{{ iconSvg('list-check') }}</span>
		<div class="hub-bulk__review-text">
			<strong>{{ 'Review the selection'|t('hub') }}</strong>
			<span>{{ 'Only the selected items are listed, whatever the filters. Unselect those to leave out, then apply an action to all selected items.'|t('hub') }}</span>
		</div>
		<div class="hub-bulk__actions" role="group" aria-label="{{ 'Actions'|t('hub') }}">
			{% for key, action in bulkActions %}
				<button {% if action.labels ?? false %}type="button" aria-haspopup="dialog" data-hub-bulk-labels{% else %}type="submit" name="bulkAction" value="{{ key }}"{% endif %} class="btn hub-bulk__apply{% if action.confirm ?? false %} hub-bulk__apply--danger{% endif %}" data-hub-bulk-apply
					{%- if action.confirm ?? false %} data-hub-confirm="{{ action.confirm }}"{% endif %}>
					<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg(action.icon) }}</span>
					<span>{{ action.label }}</span>
				</button>
			{% endfor %}
		</div>
	</div>
{% endif %}

{% block table %}{% endblock %}

{% set footer %}{% block footer %}{% endblock %}{% endset %}

{% if selectable or footer|trim %}
	<footer class="hub-panel__footer hub-bulk__footer">
		{{ footer }}
		{% if selectable %}
			{% set menuId = 'hub-bulk-' ~ random() %}
			<div class="hub-bulk__bar">
				<span class="hub-bulk__status" aria-live="polite">
					<span class="hub-bulk__count" data-hub-bulk-count data-none="{{ bulkNone }}" data-some="{{ '{count} selected'|t('hub') }}">{{ bulkNone }}</span>
					{% if selection and not review %}
						<span class="hub-bulk__outside" data-hub-bulk-outside-count data-some="{{ '{count} outside the filters'|t('hub') }}" title="{{ 'Selected, but not matching the current filters. Review the selection to see them.'|t('hub') }}" hidden></span>
					{% endif %}
				</span>

				{% if not selection %}
					<div class="btngroup hub-bulk__select" role="group" aria-label="{{ 'Selection'|t('hub') }}">
						<button type="button" class="btn" data-hub-bulk-select="all" title="{{ 'Select all'|t('app') }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square-check') }}</span>
							<span>{{ 'All'|t('app') }}</span>
						</button>
						<button type="button" class="btn" data-hub-bulk-select="none" title="{{ 'Select none'|t('hub') }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square') }}</span>
							<span>{{ 'None'|t('app') }}</span>
						</button>
						<button type="button" class="btn" data-hub-bulk-select="invert" title="{{ 'Invert selection'|t('hub') }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('right-left') }}</span>
							<span>{{ 'Invert'|t('hub') }}</span>
						</button>
					</div>
					<button type="button" class="btn hub-dropdown__toggle hub-bulk__toggle" popovertarget="{{ menuId }}" aria-haspopup="menu" disabled data-hub-bulk-toggle>
						<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('gear') }}</span>
						<span>{{ 'Actions'|t('hub') }}</span>
					</button>
					<div class="hub-dropdown__popover hub-bulk__menu" id="{{ menuId }}" popover role="menu" aria-label="{{ 'Actions'|t('hub') }}">
						{% for key, action in bulkActions %}
							<button {% if action.labels ?? false %}type="button" aria-haspopup="dialog" data-hub-bulk-labels{% else %}type="submit" name="bulkAction" value="{{ key }}"{% endif %} class="hub-bulk__action{% if action.confirm ?? false %} error{% endif %}" role="menuitem"
								{%- if action.confirm ?? false %} data-hub-confirm="{{ action.confirm }}"{% endif %}>
								<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg(action.icon) }}</span>
								<span>{{ action.label }}</span>
							</button>
						{% endfor %}
					</div>
				{% else %}
					{# Items on other pages can only be selected along with all others matching the filters, which don't apply while reviewing. #}
					{% set paged = not review and (pageInfo.totalPages ?? 1) > 1 %}
					{% set matching = pageInfo.total ?? 0 %}
					<button type="button" class="btn hub-dropdown__toggle hub-bulk__toggle" popovertarget="{{ menuId }}" aria-haspopup="menu" data-hub-bulk-toggle>
						<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square-check') }}</span>
						<span>{{ 'Select'|t('hub') }}</span>
					</button>
					<div class="hub-dropdown__popover hub-bulk__menu" id="{{ menuId }}" popover role="menu" aria-label="{{ 'Selection'|t('hub') }}">
						<button type="button" class="hub-bulk__action" role="menuitem" data-hub-bulk-select="all">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square-check') }}</span>
							<span>{{ 'Select this page'|t('hub') }}</span>
						</button>
						<button type="button" class="hub-bulk__action" role="menuitem" data-hub-bulk-select="none">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square') }}</span>
							<span>{{ 'Unselect this page'|t('hub') }}</span>
						</button>
						<button type="button" class="hub-bulk__action" role="menuitem" data-hub-bulk-select="invert">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('right-left') }}</span>
							<span>{{ 'Invert this page'|t('hub') }}</span>
						</button>
						{% if paged %}
							<hr class="hub-bulk__separator">
							<button type="button" class="hub-bulk__action" role="menuitem" data-hub-bulk-select="matching"
								{%- if matching > selection.limit %} disabled data-hub-bulk-over title="{{ 'Up to {limit, number} items can be selected at once.'|t('hub', { limit: selection.limit }) }}"{% endif %}>
								<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('filter') }}</span>
								<span>{{ 'Select all {count, number} matching'|t('hub', { count: matching }) }}</span>
							</button>
							<button type="button" class="hub-bulk__action" role="menuitem" data-hub-bulk-select="unmatching">
								<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('filter-circle-xmark') }}</span>
								<span>{{ 'Unselect all {count, number} matching'|t('hub', { count: matching }) }}</span>
							</button>
						{% endif %}
						<hr class="hub-bulk__separator">
						<button type="button" class="hub-bulk__action error" role="menuitem" data-hub-bulk-select="clear" data-hub-confirm="{{ review ? 'Unselect all {count} selected items, including those on other pages?'|t('hub') : 'Unselect all {count} selected items, including those on other pages and outside the filters?'|t('hub') }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('xmark') }}</span>
							<span>{{ 'Clear selection'|t('hub') }}</span>
						</button>
					</div>
					{% if review %}
						<a class="btn hub-bulk__back" href="{{ selection.listUrl }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('arrow-left') }}</span>
							<span>{{ 'Back to the list'|t('hub') }}</span>
						</a>
					{% else %}
						<a class="btn submit hub-bulk__review-link" href="{{ selection.reviewUrl }}" data-hub-bulk-review-link>
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('list-check') }}</span>
							<span>{{ 'Review selection'|t('hub') }}</span>
						</a>
					{% endif %}
				{% endif %}
			</div>
		{% endif %}
	</footer>
{% endif %}

{% if selectable %}
		{% if bulkActions|filter(action => action.labels ?? false)|length %}
			{{ hub.bulkLabels(labels ?? [], canManageLabels ?? false) }}
		{% endif %}

		<div class="hub-dropdown__popover hub-bulk__menu hub-context" id="hub-context-{{ random() }}" popover role="menu" data-hub-context>
			<div class="hub-context__name" data-hub-context-name></div>
			<a class="hub-bulk__action" role="menuitem" target="_blank" rel="noopener" data-hub-context-open>
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('arrow-up-right-from-square') }}</span>
				<span>{{ 'Open in a new tab'|t('hub') }}</span>
			</a>
			<button type="button" class="hub-bulk__action" role="menuitem" data-hub-context-select>
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('square-check') }}</span>
				<span data-select="{{ 'Select'|t('hub') }}" data-unselect="{{ 'Unselect'|t('hub') }}"></span>
			</button>
			{% set itemActions = bulkActions|filter(action => not (action.labels ?? false)) %}
			{% if itemActions|length %}
				<hr class="hub-bulk__separator">
			{% endif %}
			{% for key, action in itemActions %}
				<button type="submit" class="hub-bulk__action{% if action.confirm ?? false %} error{% endif %}" role="menuitem" name="bulkAction" value="{{ key }}" data-hub-context-action
					{%- if action.confirm ?? false %} data-hub-confirm="{{ action.confirm }}"{% endif %}>
					<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg(action.icon) }}</span>
					<span>{{ action.label }}</span>
				</button>
			{% endfor %}
			{% if itemActions|length < bulkActions|length %}
				{# The labels of the item, checking one labels it right away; the labels are kept in a template too, from which the item's labels are shown as they change. #}
				<div class="hub-context__labels" role="group" aria-label="{{ 'Labels'|t('hub') }}" data-hub-context-labels="{{ labelList }}">
					<hr class="hub-bulk__separator">
					{% for label in labels %}
						<label class="hub-dropdown__option hub-context__label">
							<input type="checkbox" value="{{ label.id }}">
							{{ hub.icon(label.getIcon(), label.getColor(), 'small') }}
							<span class="hub-dropdown__text">{{ label.name }}</span>
						</label>
					{% else %}
						<p class="hub-muted hub-context__empty">{{ 'No labels exist yet.'|t('hub') }}</p>
					{% endfor %}
					{% if canManageLabels ?? false %}
						<a class="hub-bulk__action" role="menuitem" href="{{ url('hub/manage/labels') }}">
							<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('tags') }}</span>
							<span>{{ 'Manage labels'|t('hub') }}</span>
						</a>
					{% endif %}
					<template data-hub-labels-template>
						{%- for label in labels %}{{ hub.label(label) }}{% endfor -%}
					</template>
				</div>
			{% endif %}
		</div>
	</form>
{% endif %}

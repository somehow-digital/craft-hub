{#
	A row of the activity log. Batches toggle the rows of their first activities, which follow them hidden, and link to
	those matching the filters, or all of them, past those (see ActivityFeedService::BATCH_PREVIEW). Their chevron, their number of changes and the row itself
	toggle them. Their action and the type of their subject link to the log filtered by them; their user is shown by their chip (see the `user` macro).

	Variables: activity (see Activity), columns, listPath, batched (whether the row is of an activity within a batch)
#}
{% import 'hub/_components/macros' as hub %}
{% set action = activity.action %}
{% set data = activity.data %}
{% set subject = activity.subject %}
{% set type = data.type ?? subject.label() %}
<tr
	{%- if action.value in ['signInFailed', 'locked'] %} data-severity="red"{% endif %}
	{%- if batched ?? false %} class="hub-activity-batched" data-hub-batch-of="{{ activity.batchId }}" hidden{% endif %}
	{%- if activity.batchCount %} class="hub-activity-batch"{% endif %}>
	<th>
		<div class="hub-name">
			{{ hub.icon(subject.icon(), subject.color()) }}
			<div class="hub-name__text">
				<span class="hub-name__title">
					{%- if activity.url -%}
						<a href="{{ activity.url }}">{{ activity.title }}</a>
					{%- else -%}
						<span>{{ activity.title }}</span>
					{%- endif -%}
				</span>
				<span class="hub-name__meta">
					{%- if type != activity.title -%}
						<a class="hub-activity-type" href="{{ url(listPath, {type: subject.value}) }}" title="{{ 'Show only activity of this type'|t('hub') }}">{{ type }}</a>
					{%- endif -%}
					{%- if activity.batchCount %}
						{%- if type != activity.title %} · {% endif -%}
						<button type="button" class="hub-activity-toggle" aria-expanded="false" data-hub-batch="{{ activity.id }}">
							{{- '{count, plural, =1{One change} other{# changes}}'|t('hub', {count: activity.batchCount}) -}}
						</button>
					{%- endif -%}
				</span>
			</div>
		</div>
	</th>
	{% for column in columns %}
		<td{{ hub.cellAttributes(column) }}>
			{%- if not column.visible -%}
			{%- elseif column.key == 'action' -%}
				<a class="hub-badge" data-color="{{ action.color() }}" href="{{ url(listPath, {event: action.group().value}) }}" title="{{ 'Show only “{action}” activity'|t('hub', {action: action.group().label()}) }}">
					<span class="hub-badge__icon" aria-hidden="true">{{ iconSvg(action.icon()) }}</span>
					{{- action.label() -}}
				</a>
			{%- elseif column.key == 'user' -%}
				{% if activity.userId %}
					<span class="hub-activity-user">
						{{- hub.user(activity.user, activity.userName) -}}
						{%- if activity.impersonatorName %}{{ hub.badge('by {name}'|t('hub', {name: activity.impersonatorName}), 'orange', 'Impersonated'|t('hub'), 'user-secret') }}{% endif -%}
					</span>
				{% else %}
					<span class="hub-muted" title="{{ 'Done by a guest, the system or on the command line'|t('hub') }}">{{ 'No user'|t('hub') }}</span>
				{% endif %}
			{%- elseif column.key == 'details' -%}
				{{ include('hub/_components/activity-details', {activity: activity}, false) }}
			{%- elseif column.key == 'site' -%}
				{% if activity.site %}{{ activity.site.name|t('site') }}{% else %}<span class="hub-muted">—</span>{% endif %}
			{%- elseif column.key == 'ip' -%}
				{% if activity.ipAddress %}<code>{{ activity.ipAddress }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}
			{%- elseif column.key == 'date' -%}
				<span title="{{ activity.dateCreated|datetime('short') }}">{{ activity.dateCreated|timestamp('short') }}</span>
			{%- elseif column.key == 'batch' -%}
				{%- if activity.batchCount -%}
					<button type="button" class="hub-activity-chevron" aria-expanded="false" aria-label="{{ 'Show changes'|t('hub') }}" data-hub-batch="{{ activity.id }}">
						{{- iconSvg('chevron-down') -}}
					</button>
				{%- endif -%}
			{%- endif -%}
		</td>
	{% endfor %}
</tr>
{% for item in activity.batched %}
	{{ include('hub/_components/activity-row', {activity: item, batched: true, listPath: listPath, columns: columns}, false) }}
{% endfor %}
{% if activity.batchCount > activity.batched|length %}
	<tr class="hub-activity-batched" data-hub-batch-of="{{ activity.id }}" hidden>
		<td colspan="{{ columns|length + 1 }}">
			{#- Batches listed by the activities of theirs matching the filters list those, by the same filters. #}
			{% set batchParams = activity.batchFiltered ? craft.app.request.queryParamsWithoutPath|filter((value, key) => key != 'page') : {} %}
			<a href="{{ url(listPath, batchParams|merge({batch: activity.id})) }}">{{ 'Show all {count, number} changes'|t('hub', {count: activity.batchCount}) }}</a>
		</td>
	</tr>
{% endif %}

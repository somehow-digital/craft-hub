{#
	Panel with the filterable list of users, on the users page.
	There can be many users, so they are filtered, sorted and paginated on the server.
	The group a detail page is limited to (`listFixed`) is neither offered nor shown.

	Variables: list (see BaseController::userListVariables()), hubSite
#}
{% import 'hub/_components/macros' as hub %}

{# Items can be labeled while there are labels, or the user can create some. #}
{% set labelable = list.canApplyLabels and (list.labels|length > 0 or list.canManageLabels) %}

{% set groupOptions = {} %}
{% for info in list.groups %}
	{% set groupOptions = groupOptions|merge({(info.group.handle): {label: info.group.name|t('site'), icon: 'users', color: 'violet'}}) %}
{% endfor %}
{% if groupOptions|length %}
	{% set groupOptions = groupOptions|merge({none: {label: 'No group'|t('hub'), color: 'gray'}}) %}
{% endif %}

{% embed 'hub/_components/panel' with {list: list, groupOptions: groupOptions, hubSite: hubSite, labelable: labelable} only %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<form method="get" class="hub-filters" action="{{ url(list.listPath) }}" data-hub-submit{% if list.bulkSelection.review ?? false %} hidden{% endif %}>
			{{ include('hub/_components/saved-filters', {savedFilters: list.savedFilters, hubSite: hubSite}, false) }}
			{{ hub.search('Search by name, username or email'|t('hub'), list.filter.search) }}
			{{ hub.dropdown('Status'|t('app'), 'circle-half-stroke', hub.choices('status', list.statuses|map((status, key) => {
				label: status.label,
				color: {active: 'green', pending: 'orange', suspended: 'red', locked: 'red'}[key] ?? 'gray',
			}), list.filter.statuses)) }}
			{% if groupOptions|length and list.listFixed != 'group' %}
				{{ hub.dropdown('User Groups'|t('app'), 'users', hub.choices('group', groupOptions, list.filter.groups)) }}
			{% endif %}
			{{ hub.dropdown('Sign-ins'|t('hub'), 'clock', hub.choices('login', {
				recent: {label: 'Recently'|t('hub'), color: 'green'},
				idle: {label: 'Idle for {months, plural, =1{one month} other{# months}}'|t('hub', {months: list.idleMonths}), color: 'orange'},
				never: {label: 'Never'|t('hub'), color: 'gray'},
			}, list.filter.logins, {label: 'Active users'|t('hub')})
				~ hub.range('login', 'Last Login'|t('app'), list.filter.loginFrom, list.filter.loginTo, {type: 'date'})) }}
			{{ hub.dropdown('Two-step verification'|t('hub'), 'shield-halved', hub.choices('twoFactor', {
				with: {label: 'Set up'|t('hub'), color: 'green'},
				without: {label: 'Not set up'|t('hub'), color: 'orange'},
			}, list.filter.twoFactor, {multiple: false, label: 'Authenticator app or passkey'|t('hub')})) }}
			{{ hub.dropdown('Content'|t('hub'), 'file-lines', hub.range('entries', 'Entries as author'|t('hub'), list.filter.entriesMin, list.filter.entriesMax)
				~ hub.range('assets', 'Assets as uploader'|t('hub'), list.filter.assetsMin, list.filter.assetsMax)
				~ hub.range('created', 'Created'|t('hub'), list.filter.createdFrom, list.filter.createdTo, {type: 'date'})) }}
			{{ hub.labelFilter(list.labelOptions, list.filter.labels) }}
			{{ hub.toggle('admin', 'Admins only'|t('hub'), list.filter.admin) }}
			{{ hub.toggle('unverified', 'Unverified email only'|t('hub'), list.filter.unverifiedEmail) }}
			{{ hub.addFilter() }}
			{{ hiddenInput('sort', list.sort) }}
			{{ hiddenInput('dir', list.dir) }}
			{{ hiddenInput('selection', (list.bulkSelection.review ?? false) ? 1 : null) }}
			{{ hub.clearFilters() }}
		</form>

		{% if list.users|length %}
			{% embed 'hub/_components/bulk' with {bulkList: 'users', bulkNone: 'No users selected'|t('hub'), list: list, labelable: labelable} only %}
				{% block table %}
					{% import 'hub/_components/macros' as hub %}
					<div class="hub-table">
						<table class="data fullwidth">
							<thead>
								<tr>
									{{ hub.bulkAll(list.bulkActions) }}
									{{ hub.sortHeader('User'|t('app'), 'user', list.sortHeaders) }}
									{{ hub.columnHeaders(list.columns, list.sortHeaders, 'users') }}
								</tr>
							</thead>
							<tbody>
								{% for user in list.users %}
									<tr{% if user.locked or user.suspended %} data-severity="red"{% elseif user.pending %} data-severity="orange"{% endif %}>
										{{ hub.bulkItem(list.bulkActions, user.id, user.friendlyName, null, [user.suspended ? 'suspended' : 'active']) }}
										<th>{{ hub.userName(user, user.admin ? hub.badge('Admin'|t('app'), 'violet', null, 'user-crown'), hub.labels(list.itemLabels[user.id] ?? [], user.id, user.friendlyName, labelable)) }}</th>
										{% for column in list.columns %}
											<td{{ hub.cellAttributes(column) }}>
												{%- if not column.visible -%}
												{%- elseif column.key == 'status' -%}
													{{ hub.userStatus(user) }}
												{%- elseif column.key == 'email' -%}
													{% if user.email %}<a href="mailto:{{ user.email }}">{{ user.email }}</a>{% else %}<span class="hub-muted">—</span>{% endif %}
													{%- if user.unverifiedEmail %} {{ hub.badge('Unverified change'|t('hub'), 'orange', user.unverifiedEmail, 'at') }}{% endif -%}
												{%- elseif column.key == 'groups' -%}
													{% if user.groups|length %}
														<span class="hub-badges">
															{%- for group in user.groups %}
																<a class="hub-badge" data-color="violet" href="{{ url(list.listPath, {group: group.handle}) }}">{{ group.name|t('site') }}</a>
															{%- endfor -%}
														</span>
													{% else %}
														<span class="hub-muted">—</span>
													{% endif %}
												{%- elseif column.key == 'entries' -%}
													{{ hub.num(list.entryCounts[user.id] ?? 0) }}
												{%- elseif column.key == 'assets' -%}
													{{ hub.num(list.assetCounts[user.id] ?? 0) }}
												{%- elseif column.key == 'twoFactor' -%}
													{% if list.twoFactor[user.id] ?? false %}
														{{ hub.badge('Set up'|t('hub'), 'green', null, 'shield-halved') }}
													{% else %}
														<span class="hub-muted">—</span>
													{% endif %}
												{%- elseif column.key == 'login' -%}
													{{ hub.date(user.lastLoginDate) }}
												{%- elseif column.key == 'created' -%}
													{{ hub.date(user.dateCreated) }}
												{%- elseif column.key == 'edit' -%}
													{%- if user.canView(currentUser) -%}
														{%- set label = 'Edit user'|t('hub') -%}
														<a class="hub-visit" href="{{ user.cpEditUrl }}" title="{{ label }}" aria-label="{{ label }}">{{ iconSvg('pen') }}</a>
													{%- endif -%}
												{%- endif -%}
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endblock %}
				{% block footer %}
					{{ include('_includes/pagination', {
						pageInfo: list.pageInfo,
						itemLabel: 'user'|t('app'),
						itemsLabel: 'users'|t('app'),
					}, false) }}
				{% endblock %}
			{% endembed %}
		{% else %}
			{{ hub.emptyList(list.bulkSelection ?? null) }}
		{% endif %}
	{% endblock %}
{% endembed %}

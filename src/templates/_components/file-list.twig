{#
	Panel with the filterable list of files, on the files page and on volume and user pages.
	There can be many files, so they are filtered, sorted and paginated on the server.
	The volume or uploader a detail page is limited to (`listFixed`) is neither offered nor shown.

	Variables: see BaseController::fileListVariables()
#}
{% import 'hub/_components/macros' as hub %}

{% set volumeOptions = {} %}
{% for info in volumes %}
	{% set volumeOptions = volumeOptions|merge({ (info.volume.handle): { label: info.volume.name|t('site'), icon: 'folder-open', color: 'amber' } }) %}
{% endfor %}

{% set kindOptions = fileKinds|map((kind, value) => { label: kind.label, icon: kind.icon, color: kind.color }) %}

{% embed 'hub/_components/panel' %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<form method="get" class="hub-filters" action="{{ url(listPath) }}" data-hub-submit>
			{% if listFixed != 'volume' %}
				{{ hub.dropdown('Volume'|t('app'), 'folder-open', hub.choices('volume', volumeOptions, filter.volumes)) }}
			{% endif %}
			{{ hub.dropdown('Type'|t('app'), 'file', hub.choices('kind', kindOptions, filter.kinds, { label: 'Kind'|t('hub') })
				~ hub.choices('extension', extensions|map((count, extension) => extension), filter.extensions, { label: 'Extension'|t('hub') })) }}
			{{ hub.dropdown('Dimensions'|t('app'), 'ruler-combined', hub.range('width', 'Width'|t('app'), filter.widthMin, filter.widthMax, { unit: 'px' })
				~ hub.range('height', 'Height'|t('app'), filter.heightMin, filter.heightMax, { unit: 'px' })
				~ hub.choices('orientation', {
					landscape: { label: 'Landscape'|t('hub'), icon: 'rectangle-wide' },
					portrait: { label: 'Portrait'|t('hub'), icon: 'rectangle-vertical' },
					square: { label: 'Square'|t('hub'), icon: 'square' },
				}, filter.orientations, { label: 'Orientation'|t('hub') })) }}
			{{ hub.dropdown('Size'|t('app'), 'weight-hanging', hub.range('size', 'Size'|t('app'), filter.sizeMin, filter.sizeMax, { unit: 'MB', step: 'any' })) }}
			{{ hub.dropdown('References'|t('hub'), 'link', hub.choices('usage', {
				used: { label: 'With references'|t('hub'), color: 'green' },
				unused: { label: 'Without references'|t('hub'), color: 'orange' },
			}, filter.usage, { multiple: false, label: 'Usage'|t('hub') })
				~ hub.range('references', 'Number of references'|t('hub'), filter.referencesMin, filter.referencesMax)) }}
			{{ hub.dropdown('Uploaded'|t('hub'), 'calendar', hub.range('uploaded', 'Upload date'|t('hub'), filter.uploadedFrom, filter.uploadedTo, { type: 'date' })
				~ (listFixed != 'uploader' ? hub.choices('uploader', uploaders|map(uploader => { label: uploader.user.name, user: uploader.user }), filter.uploaders, { label: 'Uploaded by'|t('hub') }) : '')) }}
			{{ hub.toggle('alt', 'Missing alt text only'|t('hub'), filter.missingAlt) }}
			{{ hub.toggle('oversized', 'Oversized images only'|t('hub'), filter.oversized) }}
			{{ hub.search('Search by filename or title'|t('hub'), filter.search) }}
			{{ hub.clearFilters() }}
			{{ hiddenInput('sort', sort) }}
			{{ hiddenInput('dir', dir) }}
			{{ hub.columnPicker('files', columns) }}
		</form>

		{% if assets|length %}
			{% embed 'hub/_components/bulk' with { bulkList: 'files', bulkNone: 'No files selected'|t('hub') } %}
				{% block table %}
					{% import 'hub/_components/macros' as hub %}
					<div class="hub-table">
						<table class="data fullwidth">
							<thead>
								<tr>
									{{ hub.bulkAll(bulkActions) }}
									{{ hub.sortHeader('File'|t('app'), 'file', sortHeaders) }}
									{{ hub.columnHeaders(columns, sortHeaders) }}
								</tr>
							</thead>
							<tbody>
								{% for asset in assets %}
									{% set references = referenceCounts[asset.id] ?? 0 %}
									{% set kind = fileKinds[asset.kind] ?? null %}
									<tr{% if not references %} data-severity="orange"{% endif %}>
										{{ hub.bulkItem(bulkActions, asset.id, asset.filename) }}
										<th>{{ hub.fileName(asset, not references ? hub.badge('Without references'|t('hub'), 'orange', null, 'link-slash')) }}</th>
										{% for column in columns %}
											<td{{ hub.cellAttributes(column) }}>
												{%- if not column.visible -%}
												{%- elseif column.key == 'volume' -%}
													{{ hub.chip(asset.volume) }}
												{%- elseif column.key == 'kind' -%}
													{% if kind %}{{ hub.badge(kind.label, kind.color, null, kind.icon) }}{% else %}{{ asset.kind }}{% endif %}
												{%- elseif column.key == 'dimensions' -%}
													{% if asset.width and asset.height %}{{ asset.width|number }} × {{ asset.height|number }}{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'size' -%}
													{{ hub.size(asset.size) }}
												{%- elseif column.key == 'references' -%}
													{{ hub.num(references) }}
												{%- elseif column.key == 'uploaded' -%}
													{{ hub.date(asset.dateCreated) }}
												{%- elseif column.key == 'uploader' -%}
													{% if asset.uploader %}{{ hub.element(asset.uploader) }}{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'url' -%}
													{%- set label = 'Download file'|t('hub') -%}
													<a class="hub-visit" href="{{ actionUrl('hub/files/download', { id: asset.id }) }}" title="{{ label }}" aria-label="{{ label }}">{{ iconSvg('download') }}</a>
												{%- elseif column.key == 'edit' -%}
													{%- if asset.canView(currentUser) -%}
														{%- set label = 'Edit asset'|t('hub') -%}
														<a class="hub-visit" href="{{ asset.cpEditUrl }}" title="{{ label }}" aria-label="{{ label }}">{{ iconSvg('pen') }}</a>
													{%- endif -%}
												{%- endif -%}
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endblock %}
			{% endembed %}

			<footer class="hub-panel__footer">
				{% include '_includes/pagination' with {
					pageInfo: pageInfo,
					itemLabel: 'file'|t('hub'),
					itemsLabel: 'files'|t('hub'),
				} %}
			</footer>
		{% else %}
			<p class="hub-panel__empty">{{ 'Nothing matches the current filters.'|t('hub') }}</p>
		{% endif %}
	{% endblock %}
{% endembed %}

{#
	Row of the details of a detail page with the labels of its item, while labels are enabled and it has any or the user
	may label it, which they do right here, as in the sidebar of edit pages.

	Variables: list (see ColumnService::LIST_*), id
#}
{% set labeling = craft.app.plugins.getPlugin('hub').labels.getItemVariables(list, id) %}

{% if labeling.labels is not null and (labeling.labels|length or labeling.allLabels is not null) %}
	{% do view.registerAssetBundle('SomehowDigital\\Craft\\Hub\\assets\\SidebarAsset') %}
	<div class="data hub-details__labels">
		<dt class="heading">{{ 'Labels'|t('hub') }}</dt>
		<dd class="value" data-hub-sidebar-labels="{{ list }}" data-hub-sidebar-id="{{ id }}">
			{% include 'hub/_components/label-editor' with labeling only %}
		</dd>
	</div>
{% endif %}

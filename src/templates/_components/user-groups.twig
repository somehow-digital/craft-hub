{#
	Panel with the filterable list of user groups, each linking to its page.

	Variables: list, with groups (see UserService::getGroups()), pageInfo, filter, listPath, columns, sortHeaders, sort, dir,
	and those of the labels (see BaseController::labelVariables()); hubSite
#}
{% set labelable = list.canApplyLabels and (list.labels|length > 0 or list.canManageLabels) %}

{% embed 'hub/_components/panel' with { list: list, hubSite: hubSite, labelable: labelable } only %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<form method="get" class="hub-filters" action="{{ url(list.listPath) }}" data-hub-submit{% if list.bulkSelection.review ?? false %} hidden{% endif %}>
			{{ hub.search('Search by name, handle or description'|t('hub'), list.filter.search) }}
			{{ hub.dropdown('Users'|t('app'), 'user', hub.range('users', 'Number of users'|t('hub'), list.filter.usersMin, list.filter.usersMax)) }}
			{{ hub.dropdown('Permissions'|t('app'), 'key', hub.range('permissions', 'Number of permissions'|t('hub'), list.filter.permissionsMin, list.filter.permissionsMax)) }}
			{{ hub.dropdown('Two-step verification'|t('hub'), 'shield-halved', hub.choices('twoFactor', {
				required: { label: 'Required'|t('app'), color: 'green' },
				optional: { label: 'Optional'|t('hub'), color: 'gray' },
			}, list.filter.twoFactor, { multiple: false })) }}
			{{ hub.labelFilter(list.labelOptions, list.filter.labels) }}
			{{ hub.toggle('empty', 'Empty only'|t('hub'), list.filter.empty) }}
			{{ hub.addFilter() }}
			{{ hiddenInput('sort', list.sort) }}
			{{ hiddenInput('dir', list.dir) }}
			{{ hiddenInput('selection', (list.bulkSelection.review ?? false) ? 1 : null) }}
			{{ hub.clearFilters() }}
		</form>

		{% if list.groups|length %}
			{% embed 'hub/_components/bulk' with {
				bulkList: 'userGroups',
				bulkNone: 'No user groups selected'|t('hub'),
				list: list,
				hubSite: hubSite,
				labelable: labelable,
			} only %}
				{% block table %}
					{% import 'hub/_components/macros' as hub %}
					<div class="hub-table">
						<table class="data fullwidth">
							<thead>
								<tr>
									{{ hub.bulkAll(list.bulkActions) }}
									{{ hub.sortHeader('Group'|t('hub'), 'name', list.sortHeaders) }}
									{{ hub.columnHeaders(list.columns, list.sortHeaders, 'userGroups') }}
								</tr>
							</thead>
							<tbody>
								{% for info in list.groups %}
									{% set group = info.group %}
									<tr>
										{{ hub.bulkItem(list.bulkActions, group.id, group.name|t('site')) }}
										<th>
											<div class="hub-name">
												{{ hub.icon('users', 'violet') }}
												<div class="hub-name__text">
													<span class="hub-name__title">
														<a href="{{ url('hub/data/users/groups/' ~ group.id, { hubSite: hubSite }) }}">{{ group.name|t('site') }}</a>
														{{- hub.labels(list.itemLabels[group.id] ?? [], group.id, group.name|t('site'), labelable) -}}
													</span>
													<code>{{ group.handle }}</code>
												</div>
											</div>
										</th>
										{% for column in list.columns %}
											<td{{ hub.cellAttributes(column) }}>
												{%- if not column.visible -%}
												{%- elseif column.key == 'description' -%}
													{% if group.description %}{{ group.description|t('site') }}{% else %}<span class="hub-muted">—</span>{% endif %}
												{%- elseif column.key == 'users' -%}
													{{ hub.num(info.users) }}
												{%- elseif column.key == 'permissions' -%}
													{{ hub.num(info.permissions) }}
												{%- elseif column.key == 'twoFactor' -%}
													{%- if info.requires2fa -%}
														{{ hub.badge('Required'|t('app'), 'green', null, 'shield-halved') }}
													{%- else -%}
														<span class="hub-muted">{{ 'Optional'|t('hub') }}</span>
													{%- endif -%}
												{%- elseif column.key == 'settings' -%}
													{{ hub.settings(group) }}
												{%- endif -%}
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endblock %}
				{% block footer %}
					{% include '_includes/pagination' with {
						pageInfo: list.pageInfo,
						itemLabel: 'group'|t('hub'),
						itemsLabel: 'groups'|t('hub'),
					} only %}
				{% endblock %}
			{% endembed %}
		{% else %}
			{{ hub.emptyList(list.bulkSelection ?? null) }}
		{% endif %}
	{% endblock %}
{% endembed %}

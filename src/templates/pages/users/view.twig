{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set title = user.name %}
{% set area = 'data' %}
{% set selectedSubnavItem = 'users' %}
{% set listTabs = [{id: 'entries', label: 'Entries'|t('app')}, {id: 'assets', label: 'Assets'|t('app')}] %}
{% set path = 'hub/data/users/' ~ user.id %}
{% set crumbs = [
	{label: 'Users'|t('app'), url: url('hub/data/users', {hubSite: hubSite})},
	{label: title, url: url(path, {hubSite: hubSite}), current: true},
] %}

{% block pageTitle %}
	<div class="hub-title">
		{{ hub.avatar(user, 'large') }}
		<div class="hub-title__text">
			{% set badges %}
				{{- hub.userStatus(user) -}}
				{%- if user.admin %}{{ hub.badge('Admin'|t('app'), 'violet', null, 'user-crown') }}{% endif -%}
			{% endset %}
			{{ hub.titleKind('User'|t('app'), badges) }}
			<h1 id="page-heading" class="screen-title" title="{{ title }}">{{ title }}</h1>
		</div>
	</div>
	<div id="revision-indicators"></div>
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{% if user.canView(currentUser) %}
			<a class="btn" href="{{ user.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{{ include('hub/_components/detail-labels', {list: 'users', id: user.id}, false) }}
		<div class="data">
			<dt class="heading">{{ 'Status'|t('app') }}</dt>
			<dd class="value">{{ hub.userStatus(user) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Username'|t('app') }}</dt>
			<dd class="value"><code>{{ user.username }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Email'|t('app') }}</dt>
			<dd class="value">{% if user.email %}<a href="mailto:{{ user.email }}">{{ user.email }}</a>{% else %}<span class="hub-muted">—</span>{% endif %}</dd>
		</div>
		{% if user.unverifiedEmail %}
			<div class="data">
				<dt class="heading">{{ 'Unverified email'|t('hub') }}</dt>
				<dd class="value">{{ user.unverifiedEmail }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Admin'|t('app') }}</dt>
			<dd class="value">{{ user.admin ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
		</div>
		{% if groups|length %}
			<div class="data">
				<dt class="heading">{{ 'User Groups'|t('app') }}</dt>
				<dd class="value">
					<span class="hub-badges">
						{%- for group in groups %}
							<a class="hub-badge" data-color="violet" href="{{ url('hub/data/users', {hubSite: hubSite, group: group.handle}) }}">{{ group.name|t('site') }}</a>
						{%- endfor -%}
					</span>
				</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Two-step verification'|t('hub') }}</dt>
			<dd class="value">
				<span class="hub-badges">
					{%- if twoFactor -%}
						{{ hub.badge('Set up'|t('hub'), 'green', null, 'shield-halved') }}
					{%- else -%}
						{{ hub.badge('Not set up'|t('hub'), user.admin ? 'orange' : 'gray') }}
					{%- endif -%}
					{%- if requires2fa %}{{ hub.badge('Required'|t('app'), 'blue') }}{% endif -%}
				</span>
			</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last Login'|t('app') }}</dt>
			<dd class="value">{{ hub.date(user.lastLoginDate) }}</dd>
		</div>
		{% if user.lastInvalidLoginDate %}
			<div class="data">
				<dt class="heading">{{ 'Last invalid sign-in'|t('hub') }}</dt>
				<dd class="value">
					{{ hub.date(user.lastInvalidLoginDate) }}
					{%- if user.invalidLoginCount %} <span class="hub-muted">{{ '{count, plural, =1{one attempt} other{# attempts}}'|t('hub', {count: user.invalidLoginCount}) }}</span>{% endif -%}
				</dd>
			</div>
		{% endif %}
		{% if user.locked and user.lockoutDate %}
			<div class="data">
				<dt class="heading">{{ 'Locked'|t('app') }}</dt>
				<dd class="value">{{ hub.date(user.lockoutDate) }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Password changed'|t('hub') }}</dt>
			<dd class="value">
				{{ hub.date(user.lastPasswordChangeDate) }}
				{%- if user.passwordResetRequired %} {{ hub.badge('Reset required'|t('hub'), 'orange') }}{% endif -%}
			</dd>
		</div>
		{% if user.affiliatedSite %}
			<div class="data">
				<dt class="heading">{{ 'Affiliated Site'|t('app') }}</dt>
				<dd class="value">{{ user.affiliatedSite.name|t('site') }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Created'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(user.dateCreated) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(user.dateUpdated) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'ID'|t('app') }}</dt>
			<dd class="value"><code>{{ user.id }}</code></dd>
		</div>
	</dl>
{% endblock %}

{% block overview %}
	{{ include('hub/_panels/users/permissions', {count: permissionCount, user: user, hubSite: hubSite}, false) }}

	{{ include('hub/_panels/users/references', {count: referenceCount}, false) }}

	{{ include('hub/_panels/referenced', {count: referencedCount}, false) }}

	{% if maintainedCount %}
		{{ include('hub/_panels/users/maintains', {count: maintainedCount, hubSite: hubSite}, false) }}
	{% endif %}

	{{ include('hub/_panels/activity', {subject: 'user', id: user.id}, false) }}
{% endblock %}

{% block list %}
	{% if selectedTab == 'entries' %}
		{{ include('hub/_components/entry-list', {list: list, hubSite: hubSite}, false) }}
	{% else %}
		{{ include('hub/_components/file-list', {list: list, hubSite: hubSite}, false) }}
	{% endif %}
{% endblock %}

{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set volume = info.volume %}
{% set fs = volume.fs %}

{% set title = volume.name|t('site') %}
{% set area = 'structure' %}
{% set selectedSubnavItem = 'volumes' %}
{% set listTabs = [{ id: 'assets', label: 'Assets'|t('app') }] %}
{% set statisticsTab = true %}
{% set path = 'hub/structure/volumes/' ~ volume.id %}
{% set crumbs = [
	{ label: 'Volumes'|t('app'), url: url('hub/structure/volumes', { hubSite: hubSite }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	{{ hub.pageTitle(volume, 'Volume'|t('app')) }}
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{{ hub.siteFilter() }}
		<a class="btn" href="{{ url('assets/' ~ volume.handle) }}">{{ 'View assets'|t('hub') }}</a>
		{% if currentUser.admin %}
			<a class="btn" href="{{ volume.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{% include 'hub/_components/detail-labels' with { list: 'volumes', id: volume.id } %}
		<div class="data">
			<dt class="heading">{{ 'Handle'|t('app') }}</dt>
			<dd class="value"><code>{{ volume.handle }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Filesystem'|t('hub') }}</dt>
			<dd class="value">{{ fs.name|t('site') }} <span class="hub-muted">{{ fs.displayName() }}</span></dd>
		</div>
		{% if volume.getSubpath(false) %}
			<div class="data">
				<dt class="heading">{{ 'Subpath'|t('app') }}</dt>
				<dd class="value"><code>{{ volume.getSubpath(false) }}</code></dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'URLs'|t('hub') }}</dt>
			<dd class="value">{% if info.hasUrls %}{{ hub.badge('Has URLs'|t('hub'), 'green', null, 'globe') }}{% else %}{{ hub.badge('No URLs'|t('hub')) }}{% endif %}</dd>
		</div>
		{% if volume.transformFsHandle %}
			<div class="data">
				<dt class="heading">{{ 'Transform Filesystem'|t('app') }}</dt>
				<dd class="value">{{ volume.transformFs.name|t('site') }}</dd>
			</div>
		{% endif %}
		{% if volume.getTransformSubpath(false) %}
			<div class="data">
				<dt class="heading">{{ 'Transform Subpath'|t('app') }}</dt>
				<dd class="value"><code>{{ volume.getTransformSubpath(false) }}</code></dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ '{name} Translation Method'|t('app', { name: 'Title'|t('app') }) }}</dt>
			<dd class="value">{{ hub.translationMethod(volume.titleTranslationMethod) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ '{name} Translation Method'|t('app', { name: 'Alternative Text'|t('app') }) }}</dt>
			<dd class="value">{{ hub.translationMethod(volume.altTranslationMethod) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Assets'|t('app') }}</dt>
			<dd class="value">{{ hub.num(info.stats.total) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Total size'|t('hub') }}</dt>
			<dd class="value">{{ hub.size(info.stats.size) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last upload'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(info.stats.lastUploaded) }}</dd>
		</div>
		{{ hub.identifiers(volume) }}
	</dl>
{% endblock %}

{% block overview %}
	{% include 'hub/_panels/maintainers' with { list: 'volumes', item: volume } %}

	{% include 'hub/_panels/volumes/types' %}

	{% include 'hub/_panels/volumes/relations' %}

	{% include 'hub/_panels/field-layout' with { layout: volume.getFieldLayout() } %}

	{% include 'hub/_panels/activity' with { subject: 'volume', id: volume.id } %}
{% endblock %}

{% block list %}
	{% include 'hub/_components/file-list' %}
{% endblock %}

{% extends 'hub/_layouts/assets' %}
{% import 'hub/_components/macros' as hub %}

{% set title = 'Volumes'|t('hub') %}
{% set selectedTab = 'volumes' %}

{% set kindOptions = fileKinds|map((kind, value) => { label: kind.label, icon: kind.icon, color: kind.color, count: counts.kinds[value] ?? 0 }) %}

{% block content %}
	{{ hub.summary(summary) }}

	{% embed 'hub/_components/panel' %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<form method="get" class="hub-filters" action="{{ url('hub/assets/volumes') }}" data-hub-submit>
				{{ hub.search('Search by name or handle'|t('hub'), filter.search) }}
				{{ hub.dropdown('Types'|t('hub'), 'file', hub.choices('kind', kindOptions, filter.kinds)) }}
				{{ hub.dropdown('URLs'|t('hub'), 'globe', hub.choices('urls', {
					yes: { label: 'Has URLs'|t('hub'), count: counts.urls.yes },
					no: { label: 'No URLs'|t('hub'), count: counts.urls.no },
				}, filter.urls, { multiple: false })) }}
				{{ hub.dropdown('Assets'|t('app'), 'image', hub.range('assets', 'Number of assets'|t('hub'), filter.assetsMin, filter.assetsMax)
					~ hub.range('size', 'Size'|t('app'), filter.sizeMin, filter.sizeMax, { unit: 'MB', step: 'any' })
					~ hub.range('alt', 'Missing alt text'|t('hub'), filter.altMin, filter.altMax)) }}
				{{ hub.dropdown('Last upload'|t('hub'), 'calendar', hub.range('uploaded', 'Last upload'|t('hub'), filter.uploadedFrom, filter.uploadedTo, { type: 'date' })) }}
				{{ hub.diagnosticsFilter(filter.diagnoses, counts.diagnoses) }}
				{{ hub.toggle('empty', 'Empty only'|t('hub'), filter.empty) }}
				{{ hub.clearFilters() }}
				{{ hiddenInput('sort', sort) }}
				{{ hiddenInput('dir', dir) }}
				<span class="hub-count">{{ '{count, plural, =1{One volume} other{# volumes}}'|t('hub', { count: volumes|length }) }}</span>
			</form>

			{% if volumes|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								{{ hub.sortHeader('Name'|t('app'), 'name', sortHeaders) }}
								{{ hub.sortHeader('Filesystem'|t('app'), 'fs', sortHeaders) }}
								<th>{{ 'Types'|t('hub') }}</th>
								<th>{{ 'URI'|t('hub') }}</th>
								{{ hub.sortHeader('Assets'|t('app'), 'assets', sortHeaders, 'hub-num', 'With relations / Without relations'|t('hub')) }}
								{{ hub.sortHeader('Size'|t('app'), 'size', sortHeaders, 'hub-num') }}
								{{ hub.sortHeader('Missing alt text'|t('hub'), 'alt', sortHeaders, 'hub-num', 'Images without alternative text'|t('hub')) }}
								{{ hub.sortHeader('Relations'|t('hub'), 'relations', sortHeaders, 'hub-num', 'Relations from Assets and Link fields into this volume'|t('hub')) }}
								{{ hub.sortHeader('Last upload'|t('hub'), 'uploaded', sortHeaders) }}
								{{ hub.sortHeader('Diagnostics'|t('hub'), 'diagnostics', sortHeaders) }}
							</tr>
						</thead>
						<tbody>
							{% for info in volumes %}
								{% set volume = info.volume %}
								{% set fs = volume.fs %}
								<tr{% if info.isEmpty() %} data-severity="orange"{% endif %}>
									<th>
										{{ hub.name(volume, null, info.isEmpty() ? hub.badge('Empty'|t('hub'), 'orange', null, 'box-open')) }}
									</th>
									<td>{{ fs.name|t('site') }} <span class="hub-muted">{{ fs.displayName() }}</span></td>
									<td>{{ hub.fileKinds(info.kindValues|map(kind => fileKinds[kind]), 3) }}</td>
									<td>{% if info.hasUrls %}{{ hub.icon('circle-check', 'green') }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
									<td class="hub-num">
										{{ hub.dotNum(info.stats.used, 'green', 'With relations'|t('hub')) }}
										{{ hub.dotNum(info.stats.unused, 'orange', 'Without relations'|t('hub')) }}
									</td>
									<td class="hub-num">{{ hub.size(info.stats.size) }}</td>
									<td class="hub-num">{{ hub.num(info.stats.missingAlt) }}</td>
									<td class="hub-num">{{ hub.num(info.relations.relations) }}</td>
									<td>{{ hub.date(info.stats.lastUploaded) }}</td>
									<td>{{ hub.diagnostics(diagnostics[volume.id], volume) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				<p class="hub-panel__empty">{{ 'Nothing matches the current filters.'|t('hub') }}</p>
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

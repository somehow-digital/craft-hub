{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set entryType = info.entryType %}

{% set title = entryType.name|t('site') %}
{% set area = 'structure' %}
{% set selectedSubnavItem = 'entry-types' %}
{# Entry types used by no section or field have no entries to list. #}
{% set listTabs = info.sections|length or info.nestedFields|length ? [{ id: 'entries', label: 'Entries'|t('app') }] : [] %}
{% set statisticsTab = true %}
{% set path = 'hub/structure/entry-types/' ~ entryType.id %}
{% set crumbs = [
	{ label: 'Entry Types'|t('hub'), url: url('hub/structure/entry-types', { hubSite: hubSite }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	{{ hub.pageTitle(entryType, 'Entry Type'|t('app')) }}
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{{ hub.siteFilter() }}
		{% if currentUser.admin %}
			<a class="btn" href="{{ entryType.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{% include 'hub/_components/detail-labels' with { list: 'entryTypes', id: entryType.id } only %}
		<div class="data">
			<dt class="heading">{{ 'Handle'|t('app') }}</dt>
			<dd class="value"><code>{{ entryType.handle }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Usage'|t('hub') }}</dt>
			<dd class="value">{{ hub.kinds(info.kinds) }}</dd>
		</div>
		{% if entryType.description %}
			<div class="data">
				<dt class="heading">{{ 'Description'|t('app') }}</dt>
				<dd class="value">{{ entryType.description }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Title field'|t('hub') }}</dt>
			<dd class="value">{{ entryType.hasTitleField ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
		</div>
		{% if entryType.hasTitleField %}
			<div class="data">
				<dt class="heading">{{ '{name} Translation Method'|t('app', { name: 'Title'|t('app') }) }}</dt>
				<dd class="value">{{ hub.translationMethod(entryType.titleTranslationMethod) }}</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Allow line breaks in titles'|t('app') }}</dt>
				<dd class="value">{{ entryType.allowLineBreaksInTitles ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
			</div>
		{% elseif entryType.titleFormat %}
			<div class="data">
				<dt class="heading">{{ 'Title format'|t('hub') }}</dt>
				<dd class="value"><code>{{ entryType.titleFormat }}</code></dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'UI Label Format'|t('app') }}</dt>
			<dd class="value"><code>{{ entryType.uiLabelFormat }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Show the Slug field'|t('app') }}</dt>
			<dd class="value">{{ entryType.showSlugField ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ '{name} Translation Method'|t('app', { name: 'Slug'|t('app') }) }}</dt>
			<dd class="value">{{ hub.translationMethod(entryType.slugTranslationMethod) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Show the Status field'|t('app') }}</dt>
			<dd class="value">{{ entryType.showStatusField ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(info.stats.lastUpdated) }}</dd>
		</div>
		{{ hub.identifiers(entryType) }}
	</dl>
{% endblock %}

{% block overview %}
	{% include 'hub/_panels/maintainers' with { list: 'entryTypes', item: entryType, hubSite: hubSite } only %}

	{% include 'hub/_panels/types/relations' with { info: info, entryType: entryType, siteIds: siteIds } only %}

	{% include 'hub/_panels/field-layout' with { layout: entryType.getFieldLayout() } only %}

	{% include 'hub/_panels/activity' with { subject: 'entryType', id: entryType.id } only %}
{% endblock %}

{% block list %}
	{% include 'hub/_components/entry-list' with { list: list, hubSite: hubSite } only %}
{% endblock %}

{% extends 'hub/_layouts/index' %}
{% import 'hub/_components/macros' as hub %}

{# Items can be labeled while there are labels, or the user can create some. #}
{% set labelable = list.canApplyLabels and (list.labels|length > 0 or list.canManageLabels) %}

{% set area = 'structure' %}
{% set page = 'entry-types' %}
{% set title = 'Entry Types'|t('hub') %}
{% set selectedTab = 'list' %}

{% set kindOptions = {} %}
{% for kind in list.kinds %}
	{% set kindOptions = kindOptions|merge({(kind.value): {label: kind.label(), icon: kind.icon(), color: kind.color()}}) %}
{% endfor %}

{% block content %}
	{% embed 'hub/_components/panel' with {list: list, kindOptions: kindOptions, hubSite: hubSite, labelable: labelable} only %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<form method="get" class="hub-filters" action="{{ url('hub/structure/entry-types') }}" data-hub-submit{% if list.bulkSelection.review ?? false %} hidden{% endif %}>
				{{ include('hub/_components/saved-filters', {savedFilters: list.savedFilters, hubSite: hubSite}, false) }}
				{{ hub.search('Search by name or handle'|t('hub'), list.filter.search) }}
				{{ hub.dropdown('Usage'|t('hub'), 'diagram-nested', hub.choices('kind', kindOptions, list.filter.kinds)) }}
				{{ hub.dropdown('Numbers'|t('hub'), 'hashtag', hub.range('relations', 'Relations'|t('hub'), list.filter.relationsMin, list.filter.relationsMax)
					~ hub.range('entries', 'Entries'|t('app'), list.filter.entriesMin, list.filter.entriesMax)) }}
				{{ hub.activityFilter(list.filter.activities) }}
				{{ hub.labelFilter(list.labelOptions, list.filter.labels) }}
				{{ hub.addFilter() }}
				{{ hiddenInput('sort', list.sort) }}
				{{ hiddenInput('dir', list.dir) }}
				{{ hiddenInput('selection', (list.bulkSelection.review ?? false) ? 1 : null) }}
				{{ hub.clearFilters() }}
			</form>

			{% if list.entryTypes|length %}
				{% embed 'hub/_components/bulk' with {bulkList: 'entryTypes', bulkNone: 'No entry types selected'|t('hub'), list: list, labelable: labelable} only %}
					{% block table %}
						{% import 'hub/_components/macros' as hub %}
						<div class="hub-table">
							<table class="data fullwidth">
								<thead>
									<tr>
										{{ hub.bulkAll(list.bulkActions) }}
										{{ hub.sortHeader('Name'|t('app'), 'name', list.sortHeaders) }}
										{{ hub.columnHeaders(list.columns, list.sortHeaders, 'entryTypes') }}
									</tr>
								</thead>
								<tbody>
									{% for info in list.entryTypes %}
										{% set entryType = info.entryType %}
										{% set severity = 'unused' in info.kindValues ? 'red' : ('empty' in info.kindValues ? 'orange' : null) %}
										<tr{% if severity %} data-severity="{{ severity }}"{% endif %}>
											{{ hub.bulkItem(list.bulkActions, entryType.id, entryType.name|t('site')) }}
											<th>{{ hub.name(entryType, null, null, hub.labels(list.itemLabels[entryType.id] ?? [], entryType.id, entryType.name|t('site'), labelable)) }}</th>
											{% for column in list.columns %}
												<td{{ hub.cellAttributes(column) }}>
													{%- if not column.visible -%}
													{%- elseif column.key == 'usage' -%}
														{{ hub.kinds(info.kinds|filter(kind => kind in list.kinds)) }}
													{%- elseif column.key == 'relations' -%}
														{{ hub.num(info.sections|length + info.relationCount) }}
													{%- elseif column.key == 'entries' -%}
														{{ hub.num(info.stats.total) }}
													{%- elseif column.key == 'updated' -%}
														{{ hub.activity(info.stats.lastUpdated, list.activities[entryType.id]) }}
													{%- elseif column.key == 'maintainers' -%}
														{{ hub.itemMaintainers('entryTypes', info.entryType.id) }}
													{%- elseif column.key == 'settings' -%}
														{{ hub.settings(entryType) }}
													{%- endif -%}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endblock %}
					{% block footer %}
						{{ include('_includes/pagination', {
							pageInfo: list.pageInfo,
							itemLabel: 'entry type'|t('hub'),
							itemsLabel: 'entry types'|t('hub'),
						}, false) }}
					{% endblock %}
				{% endembed %}
			{% else %}
				{{ hub.emptyList(list.bulkSelection ?? null) }}
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

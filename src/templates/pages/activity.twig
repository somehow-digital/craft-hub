{#
	The activity log, below the "Hub" navigation item: what users did, as Craft's own events tell it, newest first.
	There can be many activities, so they are filtered, sorted and paginated on the server. Subjects that still exist link
	to their Hub page, or their edit page; users link to the log filtered by them. Activities of a batch are listed within
	it (see _components/activity-row), or on their own, by the batch. Sorted by date, they are grouped by their day.

	Variables: activities (see ActivityService::populate()), pageInfo, filter (see ActivityFilter), batch (the batch whose
	activities are listed, if any), userOptions (the users filtered by, the others are loaded as the dropdown opens), optionsUrls, actions, subjects (the cases of ActivityGroup
	and ActivitySubject), retentionDays (see Settings::$activityRetentionDays), listPath, columns, sortHeaders, sort, dir
#}
{% extends '_layouts/cp' %}
{% import 'hub/_components/macros' as hub %}

{% do view.registerAssetBundle('SomehowDigital\\Craft\\Hub\\assets\\HubAsset') %}

{% set title = 'Activity'|t('hub') %}
{% set docTitle = title ~ ' - ' ~ 'Hub'|t('hub') %}
{% set selectedSubnavItem = 'activity' %}
{% set crumbs = [
	{ label: 'Hub'|t('hub'), url: url('hub/manage') },
	{ label: title, url: url(list.listPath), current: not list.batch },
] %}
{% if list.batch %}
	{% set crumbs = crumbs|merge([{ label: list.batch.title, url: url(list.listPath, { batch: list.batch.id }), current: true }]) %}
{% endif %}

{% set actionOptions = {} %}
{% for action in list.actions %}
	{% set actionOptions = actionOptions|merge({ (action.value): { label: action.label(), icon: action.icon(), color: action.color() } }) %}
{% endfor %}

{% set typeOptions = {} %}
{% for subject in list.subjects %}
	{% set typeOptions = typeOptions|merge({ (subject.value): { label: subject.label(), icon: subject.icon(), color: subject.color() } }) %}
{% endfor %}

{% block content %}
	<p class="hub-activity-summary">
		{% if list.batch %}
			{{ 'What was done by “{name}” ({action}), {date}.'|t('hub', { name: list.batch.title, action: list.batch.action.label(), date: list.batch.dateCreated|datetime('short') }) }}
			<a href="{{ url(list.listPath) }}">{{ 'Show all activity'|t('hub') }}</a>
		{% elseif list.filter.item %}
			{{ 'What was done to a single item.'|t('hub') }}
			<a href="{{ url(list.listPath) }}">{{ 'Show all activity'|t('hub') }}</a>
		{% else %}
			{{ list.retentionDays
				? 'What users did, as Craft tells it, kept for {days, plural, =1{one day} other{# days}}.'|t('hub', { days: list.retentionDays })
				: 'What users did, as Craft tells it, kept forever.'|t('hub') }}
		{% endif %}
	</p>

	{% embed 'hub/_components/panel' with { list: list, actionOptions: actionOptions, typeOptions: typeOptions } only %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<form method="get" class="hub-filters" action="{{ url(list.listPath) }}" data-hub-submit>
				{{ hub.search('Search by name or IP address'|t('hub'), list.filter.search) }}
				{{ hub.dropdown('Action'|t('hub'), 'bolt', hub.choices('event', actionOptions, list.filter.actions)) }}
				{{ hub.dropdown('Type'|t('app'), 'shapes', hub.choices('type', typeOptions, list.filter.subjects)) }}
				{{ hub.dropdown('User'|t('app'), 'user', hub.choices('user', list.userOptions, list.filter.users, { lazy: list.optionsUrls.user })) }}
				{{ hub.dropdown('Date'|t('app'), 'calendar', hub.range('date', 'Date'|t('app'), list.filter.dateFrom, list.filter.dateTo, { type: 'date' })) }}
				{{ hub.addFilter() }}
				{{ hiddenInput('sort', list.sort) }}
				{{ hiddenInput('dir', list.dir) }}
				{% if list.batch %}{{ hiddenInput('batch', list.batch.id) }}{% endif %}
				{% if list.filter.item %}{{ hiddenInput('item', list.filter.item) }}{% endif %}
				{{ hub.clearFilters() }}
			</form>

			{% if list.activities|length %}
				{% embed 'hub/_components/bulk' with { list: list|merge({ bulkActions: [] }), bulkList: 'activity' } only %}
					{% block table %}
						{% import 'hub/_components/macros' as hub %}
						<div class="hub-table">
							<table class="data fullwidth">
								<thead>
									<tr>
										{{ hub.sortHeader('Subject'|t('hub'), 'subject', list.sortHeaders) }}
										{{ hub.columnHeaders(list.columns, list.sortHeaders, 'activity') }}
									</tr>
								</thead>
								<tbody>
									{% set groupByDay = not list.sort or list.sort == 'date' %}
									{% set today = now|date('Y-m-d') %}
									{% set yesterday = now|date_modify('-1 day')|date('Y-m-d') %}
									{% set currentDay = null %}
									{% for activity in list.activities %}
										{% set day = activity.dateCreated|date('Y-m-d') %}
										{% if groupByDay and day != currentDay %}
											{% set currentDay = day %}
											<tr class="hub-activity-day">
												<td colspan="{{ list.columns|length + 1 }}">
													{{- day == today ? 'Today'|t('app') : (day == yesterday ? 'Yesterday'|t('app') : activity.dateCreated|date('full')) -}}
												</td>
											</tr>
										{% endif %}
										{% include 'hub/_components/activity-row' with { batched: false, activity: activity, listPath: list.listPath, columns: list.columns } only %}
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endblock %}
					{% block footer %}
						{% include '_includes/pagination' with {
							pageInfo: list.pageInfo,
							itemLabel: 'activity'|t('hub'),
							itemsLabel: 'activities'|t('hub'),
						} only %}
					{% endblock %}
				{% endembed %}
			{% else %}
				{{ hub.emptyList() }}
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set volume = asset.volume %}
{% set isImage = asset.kind == 'image' %}
{% set usageKind = enum('SomehowDigital\\Craft\\Hub\\enums\\UsageKind') %}

{% set title = asset.title %}
{% set area = 'data' %}
{% set selectedSubnavItem = 'assets' %}
{% set path = 'hub/data/assets/' ~ asset.id %}
{% set listTab = hasTransforms ? { id: 'transforms', label: 'Transforms'|t('hub') } : null %}
{% set crumbs = [
	{ label: 'Assets'|t('hub'), url: url('hub/data/assets', { hubSite: hubSite }) },
	{ label: volume.name|t('site'), url: url('hub/data/assets', { hubSite: hubSite, volume: volume.handle }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	<div class="hub-title">
		{{ hub.thumb(asset, 'large') }}
		<div class="hub-title__text">
			{{ hub.titleKind('Asset'|t('app'), hub.badge(fileKind.label, fileKind.color, null, fileKind.icon)) }}
			<h1 id="page-heading" class="screen-title" title="{{ title }}">{{ title }}</h1>
		</div>
	</div>
	<div id="revision-indicators"></div>
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{% if asset.url %}
			<a class="btn" href="{{ asset.url }}" target="_blank" rel="noopener">{{ 'Open file'|t('hub') }}</a>
		{% endif %}
		{% if asset.canView(currentUser) %}
			<a class="btn" href="{{ asset.cpEditUrl }}">{{ 'Edit asset'|t('hub') }}</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		<div class="data">
			<dt class="heading">{{ 'Filename'|t('app') }}</dt>
			<dd class="value"><code>{{ asset.filename }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Volume'|t('app') }}</dt>
			<dd class="value">{{ hub.chip(volume) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Folder'|t('app') }}</dt>
			<dd class="value"><code>/{{ asset.folder.path }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Path'|t('hub') }}</dt>
			<dd class="value"><code>{{ asset.path }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'URL'|t('app') }}</dt>
			<dd class="value">{% if asset.url %}<a href="{{ asset.url }}" target="_blank" rel="noopener">{{ asset.url }}</a>{% else %}<span class="hub-muted">{{ 'No URLs'|t('hub') }}</span>{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Type'|t('app') }}</dt>
			<dd class="value">{{ hub.badge(fileKind.label, fileKind.color, null, fileKind.icon) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Extension'|t('hub') }}</dt>
			<dd class="value"><code>{{ asset.extension }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'MIME type'|t('hub') }}</dt>
			<dd class="value">{% if asset.mimeType %}<code>{{ asset.mimeType }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Size'|t('app') }}</dt>
			<dd class="value">{{ hub.size(asset.size) }}{% if asset.size %} <span class="hub-muted">{{ asset.size|number }} B</span>{% endif %}</dd>
		</div>
		{% if asset.width and asset.height %}
			<div class="data">
				<dt class="heading">{{ 'Dimensions'|t('app') }}</dt>
				<dd class="value">{{ asset.width|number }} × {{ asset.height|number }} px</dd>
			</div>
		{% endif %}
		{% if asset.hasFocalPoint %}
			<div class="data">
				<dt class="heading">{{ 'Focal Point'|t('app') }}</dt>
				<dd class="value"><code>{{ asset.getFocalPoint(true) }}</code></dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Uploaded'|t('hub') }}</dt>
			<dd class="value">
				{{ hub.date(asset.dateCreated) }}
				{% if asset.uploader %}<span class="hub-muted">{{ 'by {name}'|t('hub', { name: asset.uploader.friendlyName }) }}</span>{% endif %}
			</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'File modified'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(asset.dateModified) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(asset.dateUpdated) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'ID'|t('app') }}</dt>
			<dd class="value"><code>{{ asset.id }}</code></dd>
		</div>
	</dl>
{% endblock %}

{% block overview %}
	{% if isImage %}
		{% embed 'hub/_components/panel' with { heading: 'Preview'|t('hub'), icon: 'image', color: 'sky' } %}
			{% block body %}
				<div class="hub-preview">
					{{ asset.getPreviewThumbImg(800, 400)|raw }}
				</div>
			{% endblock %}
		{% endembed %}
	{% endif %}

	{% embed 'hub/_components/panel' with {
		heading: 'Sites'|t('app'),
		description: 'Title and alternative text of the file on each site.'|t('hub'),
		icon: 'globe',
		count: sites|length,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<div class="hub-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'Site'|t('app') }}</th>
							<th>{{ 'Title'|t('app') }}</th>
							<th>{{ 'Alternative Text'|t('app') }}</th>
							<th>{{ 'Status'|t('app') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for variant in sites %}
							<tr{% if isImage and not variant.alt|trim %} data-severity="orange"{% endif %}>
								<th>{{ variant.site.name|t('site') }}</th>
								<td>{{ variant.title }}</td>
								<td>{% if variant.alt|trim %}{{ variant.alt }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
								<td><span class="status {{ variant.status }}" aria-hidden="true"></span>{{ variant.statuses()[variant.status] ?? variant.status }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endblock %}
	{% endembed %}

	{% embed 'hub/_components/panel' with {
		heading: 'References'|t('hub'),
		description: 'Elements that reference this file through a relation field. References from rich text fields are not taken into account here.'|t('hub'),
		icon: 'link',
		color: 'teal',
		count: references|length,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{% if references|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Element'|t('hub') }}</th>
								<th>{{ 'Fields'|t('app') }}</th>
								<th><span class="visually-hidden">{{ 'URL'|t('app') }}</span></th>
							</tr>
						</thead>
						<tbody>
							{% for reference in references %}
								{# Link entries and assets to their hub page instead of their edit page #}
								{% set element = reference.element %}
								{% set hubUrl = null %}
								{% if element is instance of('craft\\elements\\Entry') %}
									{% set hubUrl = url('hub/data/entries/' ~ element.id, { hubSite: hubSite }) %}
								{% elseif element is instance of('craft\\elements\\Asset') %}
									{% set hubUrl = url('hub/data/assets/' ~ element.id, { hubSite: hubSite }) %}
								{% endif %}
								<tr>
									<td>{{ elementChip(element, { hyperlink: true, attributes: hubUrl ? { data: { 'cp-url': hubUrl } } : {} }) }}</td>
									<td>
										<ul class="hub-list hub-list--plain">
											{% for path in reference.paths %}
												<li class="hub-inline">
													{% if path.field %}
														{% set kind = usageKind.from(path.field is instance of('craft\\fields\\Link') ? 'link' : 'reference') %}
														{{ hub.fieldType(path.field, kind.color()) }}
													{% endif %}
													<span>{{ path.label }}</span>
												</li>
											{% endfor %}
										</ul>
									</td>
									<td class="hub-visit-cell">{{ hub.visit(element, element is instance of('craft\\elements\\Asset') ? 'Open file'|t('hub') : 'View entry'|t('hub')) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				<p class="hub-panel__empty">{{ 'No elements reference this file.'|t('hub') }}</p>
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block list %}
	{% embed 'hub/_components/panel' with {
		heading: 'Transforms'|t('hub'),
		description: 'Image transforms generated for this file. Deleted transforms are generated again when they are next requested.'|t('hub'),
		icon: 'crop',
		color: 'violet',
		count: transforms|length,
		collapsible: false,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{# Transforms are selected by their checkbox and deleted through the actions menu, by users who can save the file. #}
			{% set selectable = canDeleteTransforms %}
			{% if transforms|length %}
				<form method="post" accept-charset="UTF-8" data-hub-bulk>
					{% if selectable %}
						{{ csrfInput() }}
						{{ actionInput('hub/files/delete-transforms') }}
						{{ hiddenInput('assetId', asset.id) }}
						{% set menuId = 'hub-bulk-' ~ random() %}
						<div class="hub-filters hub-bulk__bar">
							<span class="hub-bulk__count" data-hub-bulk-count data-none="{{ 'No transforms selected'|t('hub') }}" data-some="{{ '{count} selected'|t('hub') }}">{{ 'No transforms selected'|t('hub') }}</span>
							<button type="button" class="btn hub-dropdown__toggle hub-bulk__toggle" popovertarget="{{ menuId }}" aria-haspopup="menu" disabled data-hub-bulk-toggle>
								<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('gear') }}</span>
								<span>{{ 'Actions'|t('hub') }}</span>
							</button>
							<div class="hub-dropdown__popover hub-bulk__menu" id="{{ menuId }}" popover role="menu" aria-label="{{ 'Actions'|t('hub') }}">
								<button type="submit" class="hub-bulk__action error" role="menuitem" name="bulkAction" value="delete" data-hub-confirm="{{ 'Are you sure you want to delete the selected transforms?'|t('hub') }}">
									<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('trash') }}</span>
									<span>{{ 'Delete'|t('app') }}</span>
								</button>
							</div>
						</div>
					{% endif %}
					<div class="hub-table">
						<table class="data fullwidth">
							<thead>
								<tr>
									{% if selectable %}
										<th class="hub-check-cell">
											<input type="checkbox" aria-label="{{ 'Select all'|t('app') }}" title="{{ 'Select all'|t('app') }}" data-hub-bulk-all>
										</th>
									{% endif %}
									<th>{{ 'Transform'|t('hub') }}</th>
									<th>{{ 'Dimensions'|t('app') }}</th>
									<th>{{ 'Format'|t('hub') }}</th>
									<th>{{ 'Size'|t('app') }}</th>
									<th>{{ 'Filename'|t('app') }}</th>
									<th>{{ 'Status'|t('app') }}</th>
									<th>{{ 'Generated'|t('hub') }}</th>
									<th><span class="visually-hidden">{{ 'URL'|t('app') }}</span></th>
								</tr>
							</thead>
							<tbody>
								{% for transform in transforms %}
									<tr{% if transform.error %} data-severity="red"{% endif %}>
										{% if selectable %}
											<td class="hub-check-cell">
												<input type="checkbox" name="transformIds[]" value="{{ transform.id }}" aria-label="{{ 'Select {name}'|t('hub', { name: transform.transformString }) }}" data-hub-bulk-item>
											</td>
										{% endif %}
										<th><code>{{ transform.transformString }}</code></th>
										<td>{% if transform.width and transform.height %}{{ transform.width|number }} × {{ transform.height|number }} px{% else %}<span class="hub-muted">—</span>{% endif %}</td>
										<td>{% if transform.outputFormat %}<code>{{ transform.outputFormat }}</code>{% if not transform.format %} <span class="hub-muted" title="{{ 'Picked by Craft, as the transform doesn’t set a format'|t('hub') }}">{{ 'auto'|t('hub') }}</span>{% endif %}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
										<td>{{ hub.size(transform.size) }}</td>
										<td>{% if transform.filename %}<code>{{ transform.filename }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}</td>
										<td>
											{% if transform.error %}
												{{ hub.badge('Failed'|t('hub'), 'red', null, 'triangle-exclamation') }}
											{% elseif transform.inProgress %}
												{{ hub.badge('In progress'|t('hub'), 'amber', null, 'spinner') }}
											{% elseif transform.fileExists %}
												{{ hub.badge('Generated'|t('hub'), 'green', null, 'circle-check') }}
											{% else %}
												{{ hub.badge('Pending'|t('hub'), 'gray', null, 'clock') }}
											{% endif %}
										</td>
										<td>{{ hub.date(transform.dateIndexed) }}</td>
										<td class="hub-visit-cell">
											{%- if transform.url -%}
												<a class="hub-visit" href="{{ transform.url }}" target="_blank" rel="noopener" title="{{ 'Open transform'|t('hub') }}" aria-label="{{ 'Open transform'|t('hub') }}">{{ iconSvg('arrow-up-right-from-square') }}</a>
											{%- endif -%}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</form>
			{% else %}
				<p class="hub-panel__empty">{{ 'No transforms have been generated for this file.'|t('hub') }}</p>
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

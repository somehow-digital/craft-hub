{#
	The filters tab of the settings page: the saved filters of each list offered to everyone, in the order the lists offer
	them. Each list's filters are listed in a collapsible panel, whose header sums them up. Hub's predefined filters can be
	disabled and reordered right in the tables, custom ones deleted too, unless checks flag their items; their forms rename
	them, change the thresholds of predefined ones, like the size of large files, and the condition of custom ones. Users'
	own filters are managed in the lists, by each user.

	Variables: kinds (`kind` and its `filters` by the value of each kind, see FilterService::getFilters())
#}
{% extends 'hub/_layouts/settings' %}
{% import 'hub/_components/macros' as hub %}

{% set selectedTab = 'filters' %}

{% block content %}
	<p class="hub-labels-summary">
		{{ 'The lists offer these filters in their filter bar, in this order, drag them to reorder. Predefined filters can’t be deleted, but disabled, and some given another threshold. The checks of the diagnostics tabs flag the items of filters, too. Each user can save their own filters in the lists.'|t('hub') }}
	</p>

	<div class="hub-checks-settings">
		{% for item in kinds %}
			{% include 'hub/_panels/settings/filters' with { kind: item.kind, filters: item.filters } only %}
		{% endfor %}
	</div>
{% endblock %}

{% js %}
// Sums up the filters of a kind in its panel's header, as filters are deleted, enabled or disabled.
const updateHubFiltersHeader = (panel) => {
	const rows = panel.querySelectorAll('tbody > tr');
	const disabled = panel.querySelectorAll('tbody > tr.hub-check-row--disabled').length;
	const label = panel.querySelector('[data-hub-filters-disabled]');

	panel.querySelector('[data-hub-filters-count]').textContent = Craft.formatNumber(rows.length);
	label.textContent = Craft.t('hub', '{count} disabled', { count: Craft.formatNumber(disabled) });
	label.classList.toggle('hidden', !disabled);
};

// The tables of each kind are set up as their panel loads.
document.getElementById('content').addEventListener('hub:loaded', (event) => {
	const kind = event.target.querySelector('table.hub-checks-table')?.id.replace('hub-filters-table-', '');

	if (!kind) {
		return;
	}

	new Craft.AdminTable({
		tableSelector: `#hub-filters-table-${kind}`,
		noItemsSelector: `#hub-filters-empty-${kind}`,
		sortable: true,
		reorderAction: 'hub/filters/reorder',
		reorderSuccessMessage: {{ 'Filters reordered.'|t('hub')|json_encode|raw }},
		reorderFailMessage: {{ 'Couldn’t reorder the filters.'|t('hub')|json_encode|raw }},
		deleteAction: 'hub/filters/delete',
		confirmDeleteMessage: {{ 'Are you sure you want to delete “{name}”?'|t('hub')|json_encode|raw }},
		deleteSuccessMessage: {{ 'Filter deleted.'|t('hub')|json_encode|raw }},
		deleteFailMessage: {{ 'Couldn’t delete the filter.'|t('hub')|json_encode|raw }},
		onDeleteItem: () => updateHubFiltersHeader(document.getElementById(`hub-filters-${kind}`)),
	});
});

// Enables or disables a filter right in the table.
document.getElementById('content').addEventListener('click', async (event) => {
	const toggle = event.target.closest('[data-hub-filter-toggle]');

	if (!toggle || toggle.disabled) {
		return;
	}

	const enabled = !toggle.classList.contains('on');
	const row = toggle.closest('tr');
	toggle.disabled = true;

	try {
		const { data } = await Craft.sendActionRequest('POST', 'hub/filters/toggle', { data: { id: toggle.dataset.hubFilterToggle, enabled: enabled ? 1 : 0 } });
		toggle.classList.toggle('on', data.enabled);
		toggle.setAttribute('aria-checked', data.enabled ? 'true' : 'false');
		row.classList.toggle('hub-check-row--disabled', !data.enabled);
		row.querySelector('.hub-check-row__name .hub-icon').dataset.color = data.enabled ? row.dataset.hubColor : 'gray';
		updateHubFiltersHeader(row.closest('.hub-panel'));
		Craft.cp.displaySuccess(data.message);
	} catch {
		Craft.cp.displayError(Craft.t('hub', 'Couldn’t save the filter.'));
	} finally {
		toggle.disabled = false;
	}
});
{% endjs %}

{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set section = info.section %}

{% set title = section.name|t('site') %}
{% set area = 'structure' %}
{% set selectedSubnavItem = 'sections' %}
{% set listTabs = [{ id: 'entries', label: 'Entries'|t('app') }] %}
{% set statisticsTab = true %}
{% set path = 'hub/structure/sections/' ~ section.id %}
{% set crumbs = [
	{ label: 'Sections'|t('app'), url: url('hub/structure/sections', { hubSite: hubSite }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	{{ hub.pageTitle(section, 'Section'|t('app'), hub.sectionType(section)) }}
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{{ hub.siteFilter() }}
		<a class="btn" href="{{ url('entries/' ~ section.handle) }}">{{ 'View entries'|t('hub') }}</a>
		{% if currentUser.admin %}
			<a class="btn" href="{{ section.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{% include 'hub/_components/detail-labels' with { list: 'sections', id: section.id } %}
		<div class="data">
			<dt class="heading">{{ 'Handle'|t('app') }}</dt>
			<dd class="value"><code>{{ section.handle }}</code></dd>
		</div>
		{% if section.type == 'structure' %}
			<div class="data">
				<dt class="heading">{{ 'Max Levels'|t('app') }}</dt>
				<dd class="value">{{ section.maxLevels ?: '∞' }}</dd>
			</div>
		{% endif %}
		{% if section.type == 'structure' %}
			<div class="data">
				<dt class="heading">{{ 'Default placement'|t('hub') }}</dt>
				<dd class="value">{{ section.defaultPlacement == 'beginning' ? 'Beginning'|t('hub') : 'End'|t('hub') }}</dd>
			</div>
		{% endif %}
		{% if section.type != 'single' %}
			<div class="data">
				<dt class="heading">{{ 'Min Authors'|t('app') }}</dt>
				<dd class="value">{{ section.minAuthors|number }}</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Max Authors'|t('app') }}</dt>
				<dd class="value">{{ section.maxAuthors is null ? '∞' : section.maxAuthors|number }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Versioning'|t('hub') }}</dt>
			<dd class="value">{{ section.enableVersioning ? 'Enabled'|t('app') : 'Disabled'|t('app') }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Propagation'|t('hub') }}</dt>
			<dd class="value">{{ section.propagationMethod.value|t('app')|capitalize }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'URLs'|t('hub') }}</dt>
			<dd class="value">{% if info.hasUrls %}{{ hub.badge('Has URLs'|t('hub'), 'green', null, 'globe') }}{% else %}{{ hub.badge('No URLs'|t('hub')) }}{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Entries'|t('app') }}</dt>
			<dd class="value">{{ hub.num(info.stats.total) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Drafts'|t('app') }}</dt>
			<dd class="value">{{ hub.num(info.stats.drafts) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(info.stats.lastUpdated) }}</dd>
		</div>
		{{ hub.identifiers(section) }}
	</dl>
{% endblock %}

{% block overview %}
	{% include 'hub/_components/maintainers' with { list: 'sections', item: section } %}

	{% embed 'hub/_components/panel' with { heading: 'Sites'|t('app'), icon: 'globe', count: section.siteSettings|length } %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<div class="hub-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'Site'|t('app') }}</th>
							<th>{{ 'Entry URI Format'|t('app') }}</th>
							<th>{{ 'Template'|t('app') }}</th>
							<th>{{ 'Default Status'|t('app') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for siteSettings in section.siteSettings %}
							<tr>
								<th>{{ siteSettings.site.name|t('site') }}{% if siteSettings.siteId in selectedSites|map(site => site.id) %} {{ hub.badge('Selected'|t('hub'), 'blue') }}{% endif %}</th>
								<td>{% if siteSettings.hasUrls %}<code>{{ siteSettings.uriFormat }}</code>{% else %}{{ hub.badge('No URLs'|t('hub')) }}{% endif %}</td>
								<td>{% if siteSettings.hasUrls and siteSettings.template %}<code>{{ siteSettings.template }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}</td>
								<td><span class="status {{ siteSettings.enabledByDefault ? 'enabled' : 'disabled' }}" aria-hidden="true"></span>{{ siteSettings.enabledByDefault ? 'Enabled'|t('app') : 'Disabled'|t('app') }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endblock %}
	{% endembed %}

	{% set previewTargets = section.previewTargets ?? [] %}
	{% if previewTargets|length %}
		{% embed 'hub/_components/panel' with { heading: 'Preview Targets'|t('app'), icon: 'eye', count: previewTargets|length } %}
			{% block body %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Label'|t('app') }}</th>
								<th>{{ 'URL Format'|t('app') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for target in previewTargets %}
								<tr>
									<th>{{ target.label|t('site') }}</th>
									<td><code>{{ target.urlFormat }}</code></td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endblock %}
		{% endembed %}
	{% endif %}

	{% embed 'hub/_components/panel' with { heading: 'Entry Types'|t('hub'), icon: 'shapes', count: info.entryTypes|length } %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<div class="hub-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'Name'|t('app') }}</th>
							<th>{{ 'Usage'|t('hub') }}</th>
							<th class="hub-num">{{ 'Entries in this section'|t('hub') }}</th>
							<th class="hub-num">{{ 'Drafts'|t('app') }}</th>
							<th>{{ 'Last updated'|t('hub') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for entryType in info.entryTypes %}
							{% set stats = statistics.sumEntries(siteIds, section.id, entryType.id) %}
							<tr{% if not stats.total %} data-severity="orange"{% endif %}>
								<th>{{ hub.name(entryType, null, not stats.total ? hub.noEntriesHere()) }}</th>
								<td>{{ hub.kinds(entryTypes[entryType.id].kinds ?? []) }}</td>
								<td class="hub-num">{{ hub.num(stats.total) }}</td>
								<td class="hub-num">{{ hub.num(stats.drafts) }}</td>
								<td>{{ hub.date(stats.lastUpdated) }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endblock %}
	{% endembed %}

	{% set usageKind = enum('SomehowDigital\\Craft\\Hub\\enums\\UsageKind') %}
	{% set relationFields = info.referenceFields|map(field => { field, kind: usageKind.from('reference') })
		|merge(info.linkFields|map(field => { field, kind: usageKind.from('link') })) %}

	{% embed 'hub/_components/panel' with {
		heading: 'Relations'|t('hub'),
		description: 'Entries and Link fields that can relate to entries from this section.'|t('hub'),
		icon: 'link',
		color: 'teal',
		count: relationFields|length,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{% if relationFields|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Field'|t('app') }}</th>
								<th>{{ 'Type'|t('app') }}</th>
								<th class="hub-num">{{ 'References'|t('hub') }}</th>
								<th class="hub-num">{{ 'Referenced entries'|t('hub') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for item in relationFields %}
								{% set references = statistics.sumReferences(siteIds, item.field.id, section.id) %}
								<tr{% if not references.references %} data-severity="orange"{% endif %}>
									<th>{{ hub.name(item.field, item.kind.color()) }}</th>
									<td>{{ hub.kinds([item.kind]) }}</td>
									<td class="hub-num">{{ hub.num(references.references) }}</td>
									<td class="hub-num">{{ hub.num(references.targets) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				{{ hub.emptyState('link-slash', 'No Entries or Link field can relate to entries from this section.'|t('hub')) }}
			{% endif %}
		{% endblock %}
	{% endembed %}

	{% include 'hub/_components/item-activity' with { subject: 'section', id: section.id } %}
{% endblock %}

{% block list %}
	{% include 'hub/_components/entry-list' %}
{% endblock %}

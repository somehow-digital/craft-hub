{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set section = info.section %}

{% set title = section.name|t('site') %}
{% set area = 'structure' %}
{% set selectedSubnavItem = 'sections' %}
{% set listTabs = [{ id: 'entries', label: 'Entries'|t('app') }] %}
{% set statisticsTab = true %}
{% set path = 'hub/structure/sections/' ~ section.id %}
{% set crumbs = [
	{ label: 'Sections'|t('app'), url: url('hub/structure/sections', { hubSite: hubSite }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	{{ hub.pageTitle(section, 'Section'|t('app'), hub.sectionType(section)) }}
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{{ hub.siteFilter() }}
		<a class="btn" href="{{ url('entries/' ~ section.handle) }}">{{ 'View entries'|t('hub') }}</a>
		{% if currentUser.admin %}
			<a class="btn" href="{{ section.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{% include 'hub/_components/detail-labels' with { list: 'sections', id: section.id } %}
		<div class="data">
			<dt class="heading">{{ 'Handle'|t('app') }}</dt>
			<dd class="value"><code>{{ section.handle }}</code></dd>
		</div>
		{% if section.type == 'structure' %}
			<div class="data">
				<dt class="heading">{{ 'Max Levels'|t('app') }}</dt>
				<dd class="value">{{ section.maxLevels ?: '∞' }}</dd>
			</div>
		{% endif %}
		{% if section.type == 'structure' %}
			<div class="data">
				<dt class="heading">{{ 'Default placement'|t('hub') }}</dt>
				<dd class="value">{{ section.defaultPlacement == 'beginning' ? 'Beginning'|t('hub') : 'End'|t('hub') }}</dd>
			</div>
		{% endif %}
		{% if section.type != 'single' %}
			<div class="data">
				<dt class="heading">{{ 'Min Authors'|t('app') }}</dt>
				<dd class="value">{{ section.minAuthors|number }}</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Max Authors'|t('app') }}</dt>
				<dd class="value">{{ section.maxAuthors is null ? '∞' : section.maxAuthors|number }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Versioning'|t('hub') }}</dt>
			<dd class="value">{{ section.enableVersioning ? 'Enabled'|t('app') : 'Disabled'|t('app') }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Propagation'|t('hub') }}</dt>
			<dd class="value">{{ section.propagationMethod.value|t('app')|capitalize }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'URLs'|t('hub') }}</dt>
			<dd class="value">{% if info.hasUrls %}{{ hub.badge('Has URLs'|t('hub'), 'green', null, 'globe') }}{% else %}{{ hub.badge('No URLs'|t('hub')) }}{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Entries'|t('app') }}</dt>
			<dd class="value">{{ hub.num(info.stats.total) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Drafts'|t('app') }}</dt>
			<dd class="value">{{ hub.num(info.stats.drafts) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(info.stats.lastUpdated) }}</dd>
		</div>
		{{ hub.identifiers(section) }}
	</dl>
{% endblock %}

{% block overview %}
	{% include 'hub/_panels/maintainers' with { list: 'sections', item: section } %}

	{% include 'hub/_panels/sections/sites' %}

	{% if (section.previewTargets ?? [])|length %}
		{% include 'hub/_panels/sections/preview-targets' %}
	{% endif %}

	{% include 'hub/_panels/sections/entry-types' %}

	{% include 'hub/_panels/sections/relations' %}

	{% include 'hub/_panels/activity' with { subject: 'section', id: section.id } %}
{% endblock %}

{% block list %}
	{% include 'hub/_components/entry-list' %}
{% endblock %}

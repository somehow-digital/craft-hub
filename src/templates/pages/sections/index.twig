{% extends 'hub/_layouts/index' %}
{% import 'hub/_components/macros' as hub %}

{# Items can be labeled while there are labels, or the user can create some. #}
{% set labelable = list.canApplyLabels and (list.labels|length > 0 or list.canManageLabels) %}

{% set area = 'structure' %}
{% set page = 'sections' %}
{% set title = 'Sections'|t('app') %}
{% set selectedTab = 'list' %}

{% set typeOptions = {} %}
{% for type in enum_cases('SomehowDigital\\Craft\\Hub\\enums\\SectionType') %}
	{% set typeOptions = typeOptions|merge({(type.value): {label: type.label(), icon: type.icon(), color: type.color()}}) %}
{% endfor %}

{% block content %}
	{% embed 'hub/_components/panel' with {list: list, typeOptions: typeOptions, hubSite: hubSite, labelable: labelable} only %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<form method="get" class="hub-filters" action="{{ url('hub/structure/sections') }}" data-hub-submit{% if list.bulkSelection.review ?? false %} hidden{% endif %}>
				{{ include('hub/_components/saved-filters', {savedFilters: list.savedFilters, hubSite: hubSite}, false) }}
				{{ hub.search('Search by name or handle'|t('hub'), list.filter.search) }}
				{{ hub.dropdown('Type'|t('app'), 'sitemap', hub.choices('type', typeOptions, list.filter.types)) }}
				{{ hub.dropdown('URLs'|t('hub'), 'globe', hub.choices('urls', {
					yes: {label: 'Has URLs'|t('hub')},
					no: {label: 'No URLs'|t('hub')},
				}, list.filter.urls, {multiple: false})) }}
				{{ hub.dropdown('Numbers'|t('hub'), 'hashtag', hub.range('entries', 'Entries'|t('app'), list.filter.entriesMin, list.filter.entriesMax)
					~ hub.range('references', 'References'|t('hub'), list.filter.referencesMin, list.filter.referencesMax)) }}
				{{ hub.activityFilter(list.filter.activities) }}
				{{ hub.labelFilter(list.labelOptions, list.filter.labels) }}
				{{ hub.toggle('empty', 'Empty only'|t('hub'), list.filter.empty) }}
				{{ hub.addFilter() }}
				{{ hiddenInput('sort', list.sort) }}
				{{ hiddenInput('dir', list.dir) }}
				{{ hiddenInput('selection', (list.bulkSelection.review ?? false) ? 1 : null) }}
				{{ hub.clearFilters() }}
			</form>

			{% if list.sections|length %}
				{% embed 'hub/_components/bulk' with {bulkList: 'sections', bulkNone: 'No sections selected'|t('hub'), list: list, labelable: labelable} only %}
					{% block table %}
						{% import 'hub/_components/macros' as hub %}
						<div class="hub-table">
							<table class="data fullwidth">
								<thead>
									<tr>
										{{ hub.bulkAll(list.bulkActions) }}
										{{ hub.sortHeader('Name'|t('app'), 'name', list.sortHeaders) }}
										{{ hub.columnHeaders(list.columns, list.sortHeaders, 'sections') }}
									</tr>
								</thead>
								<tbody>
									{% for info in list.sections %}
										{% set section = info.section %}
										<tr{% if info.isEmpty() %} data-severity="orange"{% endif %}>
											{{ hub.bulkItem(list.bulkActions, section.id, section.name|t('site')) }}
											<th>
												{{ hub.name(section, null, info.isEmpty() ? hub.badge('Empty'|t('hub'), 'orange', null, 'box-open'), hub.labels(list.itemLabels[section.id] ?? [], section.id, section.name|t('site'), labelable)) }}
											</th>
											{% for column in list.columns %}
												<td{{ hub.cellAttributes(column) }}>
													{%- if not column.visible -%}
													{%- elseif column.key == 'type' -%}
														{{ hub.sectionType(section) }}
													{%- elseif column.key == 'entryTypes' -%}
														{{ hub.chips(info.entryTypes) }}
													{%- elseif column.key == 'uri' -%}
														{% if info.hasUrls %}{{ hub.icon('circle-check', 'green') }}{% else %}<span class="hub-muted">—</span>{% endif %}
													{%- elseif column.key == 'entries' -%}
														{{ hub.dotNum(info.stats.enabled, 'green', 'Enabled'|t('app')) }}
														{{ hub.dotNum(info.stats.drafts, 'amber', 'Drafts'|t('app')) }}
														{{ hub.dotNum(info.stats.disabled, 'gray', 'Disabled'|t('app')) }}
													{%- elseif column.key == 'references' -%}
														{{ hub.num(info.references.references) }}
													{%- elseif column.key == 'updated' -%}
														{{ hub.activity(info.stats.lastUpdated, list.activities[section.id]) }}
													{%- elseif column.key == 'maintainers' -%}
														{{ hub.itemMaintainers('sections', info.section.id) }}
													{%- elseif column.key == 'settings' -%}
														{{ hub.settings(section) }}
													{%- endif -%}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endblock %}
					{% block footer %}
						{{ include('_includes/pagination', {
							pageInfo: list.pageInfo,
							itemLabel: 'section'|t('hub'),
							itemsLabel: 'sections'|t('hub'),
						}, false) }}
					{% endblock %}
				{% endembed %}
			{% else %}
				{{ hub.emptyList(list.bulkSelection ?? null) }}
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

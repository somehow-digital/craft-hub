{% extends 'hub/_layouts/entries' %}
{% import 'hub/_components/macros' as hub %}

{% set title = 'Sections'|t('hub') %}
{% set selectedTab = 'sections' %}

{% set typeOptions = {} %}
{% for type in enum_cases('SomehowDigital\\Craft\\Hub\\enums\\SectionType') %}
	{% set typeOptions = typeOptions|merge({ (type.value): { label: type.label(), icon: type.icon(), color: type.color() } }) %}
{% endfor %}

{% block content %}
	<div data-hub-list>
		{{ hub.summary(summary) }}

		{% embed 'hub/_components/panel' %}
			{% block body %}
				{% import 'hub/_components/macros' as hub %}
				<div class="hub-filters">
					{{ hub.search('Search by name or handle'|t('hub')) }}
					{{ hub.siteFilter() }}
					{{ hub.dropdown('Type'|t('app'), 'sitemap', hub.choices('type', typeOptions)) }}
					{{ hub.dropdown('URLs'|t('hub'), 'globe', hub.choices('urls', {
						yes: 'Has URLs'|t('hub'),
						no: 'No URLs'|t('hub'),
					}, null, { multiple: false })) }}
					{{ hub.dropdown('Numbers'|t('hub'), 'hashtag', hub.range('entries', 'Entries'|t('app'), null, null)
						~ hub.range('relations', 'Relations'|t('hub'), null, null)) }}
					{{ hub.activityFilter() }}
					{{ hub.toggle('empty', 'empty', 'Empty only'|t('hub')) }}
					{{ hub.clearFilters() }}
					{{ hub.count() }}
				</div>

				<div class="hub-table">
					<table class="data fullwidth" data-hub-table>
						<thead>
							<tr>
								<th data-hub-sort="name">{{ 'Name'|t('app') }}</th>
								<th data-hub-sort="type">{{ 'Type'|t('app') }}</th>
								<th>{{ 'Entry Types'|t('hub') }}</th>
								<th>{{ 'URLs'|t('hub') }}</th>
								<th class="hub-num" data-hub-sort="entries" data-hub-sort-type="number" title="{{ 'Enabled / Drafts / Disabled'|t('hub') }}">{{ 'Entries'|t('app') }}</th>
								<th class="hub-num" data-hub-sort="relations" data-hub-sort-type="number" title="{{ 'Relations from Entries and Link fields into this section'|t('hub') }}">{{ 'Relations'|t('hub') }}</th>
								<th data-hub-sort="updated" data-hub-sort-type="number">{{ 'Last updated'|t('hub') }}</th>
								<th data-hub-sort="review" data-hub-sort-type="number">{{ 'Review'|t('hub') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for info in sections %}
								{% set section = info.section %}
								<tr
									data-search="{{ (section.name ~ ' ' ~ section.handle)|lower }}"
									data-name="{{ section.name }}"
									data-type="{{ section.type }}"
									data-urls="{{ info.hasUrls ? 'yes' : 'no' }}"
									data-empty="{{ info.isEmpty() ? '1' : '' }}"
									data-activity="{{ activities[section.id] }}"
									data-entries="{{ info.stats.total }}"
									data-relations="{{ info.relations.relations }}"
									data-updated="{{ hub.timestamp(info.stats.lastUpdated) }}"
									data-review="{{ hub.reviewRank(reviews[section.id]) }}"
									{% if info.isEmpty() %}data-severity="orange"{% endif %}
								>
									<th>
										{{ hub.name(section, null, info.isEmpty() ? hub.badge('Empty'|t('hub'), 'orange', null, 'box-open')) }}
									</th>
									<td>{{ hub.sectionType(section) }}</td>
									<td>{{ hub.chips(info.entryTypes) }}</td>
									<td>{% if info.hasUrls %}{{ hub.badge('Has URLs'|t('hub'), 'green', null, 'globe') }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
									<td class="hub-num">
										{{ hub.dotNum(info.stats.enabled, 'green', 'Enabled'|t('hub')) }}
										{{ hub.dotNum(info.stats.drafts, 'amber', 'Drafts'|t('hub')) }}
										{{ hub.dotNum(info.stats.disabled, 'gray', 'Disabled'|t('hub')) }}
									</td>
									<td class="hub-num">{{ hub.num(info.relations.relations) }}</td>
									<td>{{ hub.activity(info.stats.lastUpdated, activities[section.id]) }}</td>
									<td>{{ hub.review(reviews[section.id], section) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{{ hub.empty() }}
			{% endblock %}
		{% endembed %}
	</div>
{% endblock %}

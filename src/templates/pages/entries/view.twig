{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set section = entry.section %}
{# Nested entries have no section, but a field and an owner. #}
{% set field = section ? null : entry.field %}
{% set entryType = entry.type %}
{% set usageKind = enum('SomehowDigital\\Craft\\Hub\\enums\\UsageKind') %}

{# Plain text for the crumbs and document title; the heading styles a missing title as such. #}
{% set title = entry.title|trim ?: 'Untitled'|t('hub') %}
{% set area = 'data' %}
{% set selectedSubnavItem = 'entries' %}
{% set path = 'hub/data/entries/' ~ entry.id %}
{% set listTabs = hasHistory ? [{ id: 'history', label: 'History'|t('hub') }] : [] %}
{% set crumbs = [
	{ label: 'Entries'|t('hub'), url: url('hub/data/entries', { hubSite: hubSite }) },
	section
		? { label: section.name|t('site'), url: url('hub/data/entries', { hubSite: hubSite, section: section.handle }) }
		: { label: field.name|t('site'), url: url('hub/data/entries', { hubSite: hubSite, field: field.handle }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	<div class="hub-title">
		{{ hub.itemIcon(entryType, null, 'large') }}
		<div class="hub-title__text">
			{{ hub.titleKind('Entry'|t('app')) }}
			<h1 id="page-heading" class="screen-title" title="{{ title }}">{{ hub.elementTitle(entry) }}</h1>
		</div>
	</div>
	<div id="revision-indicators"></div>
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{# Section entries are viewed at the preview targets of their section, picked from a menu when there are several. #}
		{% set targets = entry.previewTargets %}
		{% if targets|length > 1 %}
			<button type="button" class="btn menubtn" popovertarget="hub-preview-targets" aria-haspopup="menu">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('arrow-up-right-from-square') }}</span>
				{{ 'View entry'|t('hub') }}
			</button>
			{{ hub.previewTargets(targets, 'hub-preview-targets', 'View entry'|t('hub')) }}
		{% elseif targets|length or entry.url %}
			{% set target = targets|first %}
			<a class="btn" href="{{ target ? target.url : entry.url }}" target="_blank" rel="noopener"{% if target %} title="{{ target.label }}"{% endif %}>
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('arrow-up-right-from-square') }}</span>
				{{ 'View entry'|t('hub') }}
			</a>
		{% endif %}
		{% if entry.canView(currentUser) %}
			<a class="btn" href="{{ entry.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		<div class="data">
			<dt class="heading">{{ 'Status'|t('app') }}</dt>
			<dd class="value"><span class="status {{ entry.status }}" aria-hidden="true"></span>{{ entry.statuses()[entry.status] ?? entry.status }}</dd>
		</div>
		{% if section %}
			<div class="data">
				<dt class="heading">{{ 'Section'|t('app') }}</dt>
				<dd class="value">{{ hub.chip(section) }}</dd>
			</div>
		{% else %}
			<div class="data">
				<dt class="heading">{{ 'Field'|t('app') }}</dt>
				<dd class="value">{{ hub.chip(field, 'violet') }}</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Owner'|t('hub') }}</dt>
				<dd class="value">{% if entry.owner %}{{ hub.element(entry.owner) }}{% else %}<span class="hub-muted">—</span>{% endif %}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Entry Type'|t('app') }}</dt>
			<dd class="value">{{ hub.chip(entryType) }}</dd>
		</div>
		{% if entry.parent %}
			<div class="data">
				<dt class="heading">{{ 'Parent'|t('app') }}</dt>
				<dd class="value"><a href="{{ hub.url(entry.parent) }}">{{ hub.elementTitle(entry.parent) }}</a></dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Slug'|t('app') }}</dt>
			<dd class="value"><code>{{ entry.slug }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'URI'|t('hub') }}</dt>
			<dd class="value">{% if entry.uri %}<code>{{ entry.uri }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'URL'|t('app') }}</dt>
			<dd class="value">{% if entry.url %}<a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.url }}</a>{% else %}<span class="hub-muted">{{ 'No URLs'|t('hub') }}</span>{% endif %}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Authors'|t('app') }}</dt>
			<dd class="value">
				{% if entry.authors|length %}
					{% for author in entry.authors %}{{ hub.link(hub.url(author), author.friendlyName) }}{% if not loop.last %}, {% endif %}{% endfor %}
				{% else %}
					<span class="hub-muted">—</span>
				{% endif %}
			</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Post Date'|t('app') }}</dt>
			<dd class="value">{{ hub.date(entry.postDate) }}</dd>
		</div>
		{% if entry.expiryDate %}
			<div class="data">
				<dt class="heading">{{ 'Expiry Date'|t('app') }}</dt>
				<dd class="value">{{ hub.date(entry.expiryDate) }}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Created'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(entry.dateCreated) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last updated'|t('hub') }}</dt>
			<dd class="value">{{ hub.date(entry.dateUpdated) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Last edited'|t('hub') }}</dt>
			<dd class="value">
				{{ hub.activity(lastEdit.date, stale ? 'stale' : 'recent') }}
				{% if lastEdit.user %}<span class="hub-muted">{{ 'by {user}'|t('hub', { user: lastEdit.user.friendlyName }) }}</span>{% endif %}
			</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'ID'|t('app') }}</dt>
			<dd class="value"><code>{{ entry.id }}</code></dd>
		</div>
	</dl>
{% endblock %}

{% block overview %}
	{% embed 'hub/_components/panel' with {
		heading: 'Sites'|t('app'),
		description: 'Title, slug and URI of the entry on each site.'|t('hub'),
		icon: 'globe',
		count: sites|length,
	} %}
		{% block body %}
			<div class="hub-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'Site'|t('app') }}</th>
							<th>{{ 'Title'|t('app') }}</th>
							<th>{{ 'Slug'|t('app') }}</th>
							<th>{{ 'URI'|t('hub') }}</th>
							<th>{{ 'Status'|t('app') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for variant in sites %}
							<tr>
								<th>{{ variant.site.name|t('site') }}</th>
								<td>{{ variant.title }}</td>
								<td><code>{{ variant.slug }}</code></td>
								<td>{% if variant.uri %}<code>{{ variant.uri }}</code>{% else %}<span class="hub-muted">—</span>{% endif %}</td>
								<td><span class="status {{ variant.status }}" aria-hidden="true"></span>{{ variant.statuses()[variant.status] ?? variant.status }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endblock %}
	{% endembed %}

	{% embed 'hub/_components/panel' with {
		heading: 'References'|t('hub'),
		description: 'Elements that reference this entry through a relation field or a link in rich text.'|t('hub'),
		icon: 'link',
		color: 'teal',
		count: references|reduce((total, reference) => total + reference.paths|length, 0),
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{% if references|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Element'|t('hub') }}</th>
								<th>{{ 'Field'|t('app') }}</th>
								<th><span class="visually-hidden">{{ 'URL'|t('app') }}</span></th>
							</tr>
						</thead>
						<tbody>
							{# One row per reference, so an element referencing through several fields is listed once for each #}
							{% for reference in references %}
								{% set element = reference.element %}
								{% for path in reference.paths %}
									<tr>
										<td>{{ hub.element(element) }}</td>
										<td>
											<span class="hub-inline">
												{% if path.field %}
													{% set kind = usageKind.from(path.field is instance of('craft\\fields\\Link') ? 'link' : 'reference') %}
													{{ hub.fieldType(path.field, kind.color()) }}
												{% endif %}
												<span>{{ path.label }}</span>
											</span>
										</td>
										<td class="hub-visit-cell">{{ hub.visit(element, element is instance of('craft\\elements\\Asset') ? 'Open file'|t('hub') : 'View entry'|t('hub')) }}</td>
									</tr>
								{% endfor %}
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				{{ hub.emptyState('link-slash', 'No other elements reference this entry.'|t('hub')) }}
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block list %}
	{% set canView = entry.canView(currentUser) %}
	{# Revisions open on the front end through a preview token, for entries that have a URL. #}
	{% set viewRevisions = canView and entry.url %}

	{% embed 'hub/_components/panel' with {
		heading: 'Revisions'|t('app'),
		description: 'Versions of the entry saved on this site, newest first. The current revision is what the entry shows now.'|t('hub'),
		icon: 'clock-rotate-left',
		color: 'blue',
		count: pageInfo.total,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{% if revisions|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Revision'|t('app') }}</th>
								<th>{{ 'Created at'|t('app') }}</th>
								<th>{{ 'Created by'|t('app') }}</th>
								<th>{{ 'Notes'|t('app') }}</th>
								{% if viewRevisions %}
									<th><span class="visually-hidden">{{ 'URL'|t('app') }}</span></th>
								{% endif %}
							</tr>
						</thead>
						<tbody>
							{% for revision in revisions %}
								{% set creator = revision.getCreator() %}
								<tr>
									<th>
										<span class="hub-inline">
											{% if canView %}
												<a href="{{ revision.cpEditUrl }}">{{ revision.getRevisionLabel() }}</a>
											{% else %}
												<span>{{ revision.getRevisionLabel() }}</span>
											{% endif %}
											{% if currentRevision and revision.id == currentRevision.id %}
												{{ hub.badge('Current'|t('hub'), 'green', null, 'circle-check') }}
											{% endif %}
										</span>
									</th>
									<td>{{ hub.date(revision.dateCreated) }}</td>
									<td>{% if creator %}{{ hub.element(creator) }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
									<td>{% if revision.revisionNotes %}{{ revision.revisionNotes }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
									{% if viewRevisions %}
										<td class="hub-visit-cell">
											<a class="hub-visit" href="{{ actionUrl('hub/entries/view-revision', { id: entry.id, revisionId: revision.id }) }}" target="_blank" rel="noopener" title="{{ 'View revision'|t('hub') }}" aria-label="{{ 'View revision'|t('hub') }}">{{ iconSvg('arrow-up-right-from-square') }}</a>
										</td>
									{% endif %}
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<footer class="hub-panel__footer">
					{% include '_includes/pagination' with {
						pageInfo: pageInfo,
						itemLabel: 'revision'|t('app'),
						itemsLabel: 'revisions'|t('app'),
					} %}
				</footer>
			{% else %}
				{{ hub.emptyState('clock-rotate-left', 'The entry has no revisions on this site yet.'|t('hub')) }}
			{% endif %}
		{% endblock %}
	{% endembed %}

	{% embed 'hub/_components/panel' with {
		heading: 'Drafts'|t('app'),
		description: 'Saved drafts of the entry on this site, last updated first. Publish or discard them, so changes don’t get lost.'|t('hub'),
		icon: 'pen-to-square',
		color: 'amber',
		count: drafts|length,
	} %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{% if drafts|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								<th>{{ 'Draft'|t('app') }}</th>
								<th>{{ 'Created by'|t('app') }}</th>
								<th>{{ 'Last updated'|t('hub') }}</th>
								<th>{{ 'Notes'|t('app') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for draft in drafts %}
								{% set creator = draft.getCreator() %}
								<tr>
									<th>
										<span class="hub-inline">
											{% if canView %}
												<a href="{{ draft.cpEditUrl }}">{{ draft.draftName }}</a>
											{% else %}
												<span>{{ draft.draftName }}</span>
											{% endif %}
											{% if draft.getIsOutdated() %}
												{{ hub.badge('Outdated'|t('hub'), 'amber', 'The entry was changed since the draft was created.'|t('hub'), 'triangle-exclamation') }}
											{% endif %}
										</span>
									</th>
									<td>{% if creator %}{{ hub.element(creator) }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
									<td>{{ hub.date(draft.dateUpdated) }}</td>
									<td>{% if draft.draftNotes %}{{ draft.draftNotes }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				{{ hub.emptyState('file-pen', 'The entry has no drafts on this site.'|t('hub')) }}
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

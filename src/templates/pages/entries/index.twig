{% extends 'hub/_layouts/entries' %}
{% import 'hub/_components/macros' as hub %}

{% set title = 'Entries'|t('hub') %}
{% set selectedTab = 'entries' %}

{% set sectionOptions = {} %}
{% for info in sections %}
	{% set sectionOptions = sectionOptions|merge({ (info.section.handle): { label: info.section.name|t('site'), count: info.stats.total } }) %}
{% endfor %}

{# Only entry types used by sections, as nested entries aren't listed. #}
{% set typeOptions = {} %}
{% for info in entryTypes|filter(info => info.sections|length) %}
	{% set typeOptions = typeOptions|merge({ (info.entryType.handle): { label: info.entryType.name|t('site'), count: counts.types[info.entryType.handle] ?? 0, icon: info.entryType.icon ?: 'shapes', color: info.entryType.color.value ?? 'gray' } }) %}
{% endfor %}

{% block content %}
	{{ hub.summary(summary) }}

	{% embed 'hub/_components/panel' %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			{# There can be many entries, so they are filtered, sorted and paginated on the server. #}
			<form method="get" class="hub-filters" action="{{ url('hub/entries/entries') }}" data-hub-submit>
				{{ hub.search('Search by title or slug'|t('hub'), filter.search) }}
				{{ hub.siteFilter() }}
				{{ hub.dropdown('Section'|t('app'), 'layer-group', hub.choices('section', sectionOptions, filter.sections)) }}
				{{ hub.dropdown('Entry Type'|t('app'), 'shapes', hub.choices('type', typeOptions, filter.types)) }}
				{{ hub.dropdown('Status'|t('app'), 'circle-half-stroke', hub.choices('status', statuses|map((label, status) => { label: label, count: counts.statuses[status] ?? 0, color: { live: 'green', pending: 'orange', expired: 'red' }[status] ?? 'gray' }), filter.statuses)) }}
				{{ hub.dropdown('Author'|t('app'), 'user', hub.choices('author', authors|map(author => { label: author.user.name, count: author.count }), filter.authors)) }}
				{{ hub.dropdown('Relations'|t('hub'), 'link', hub.choices('usage', {
					referenced: { label: 'Referenced'|t('hub'), count: counts.usage.referenced, color: 'green' },
					unreferenced: { label: 'Unreferenced'|t('hub'), count: counts.usage.unreferenced, color: 'orange' },
				}, filter.usage, { multiple: false, label: 'Usage'|t('hub') })
					~ hub.range('relations', 'Number of relations'|t('hub'), filter.relationsMin, filter.relationsMax)) }}
				{{ hub.dropdown('Dates'|t('hub'), 'calendar', hub.range('posted', 'Post Date'|t('app'), filter.postedFrom, filter.postedTo, { type: 'date' })
					~ hub.range('updated', 'Last updated'|t('hub'), filter.updatedFrom, filter.updatedTo, { type: 'date' })) }}
				{{ hub.toggle('stale', 'stale', 'Stale only'|t('hub'), filter.staleMonths is not null) }}
				{{ hub.clearFilters() }}
				{{ hiddenInput('sort', sort) }}
				{{ hiddenInput('dir', dir) }}
				<span class="hub-count">{{ '{count, plural, =1{One entry} other{# entries}}'|t('hub', { count: pageInfo.total }) }}</span>
			</form>

			{% if entries|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								{{ hub.sortHeader('Title'|t('app'), 'title', sortHeaders) }}
								{{ hub.sortHeader('Section'|t('app'), 'section', sortHeaders) }}
								{{ hub.sortHeader('Entry Type'|t('app'), 'type', sortHeaders) }}
								<th>{{ 'Status'|t('app') }}</th>
								{{ hub.sortHeader('Relations'|t('hub'), 'relations', sortHeaders, 'hub-num', 'Relations from relation fields to this entry'|t('hub')) }}
								{{ hub.sortHeader('Post Date'|t('app'), 'posted', sortHeaders) }}
								{{ hub.sortHeader('Last updated'|t('hub'), 'updated', sortHeaders) }}
								<th>{{ 'Review'|t('hub') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for entry in entries %}
								{% set relations = relationCounts[entry.id] ?? 0 %}
								<tr>
									<th>
										<div class="hub-name">
											{{ hub.itemIcon(entry.type) }}
											<div class="hub-name__text">
												<span class="hub-name__title"><a href="{{ hub.url(entry) }}">{{ entry.title ?: entry.slug }}</a></span>
												<code>{{ entry.slug }}</code>
											</div>
										</div>
									</th>
									<td>{{ hub.chip(entry.section) }}</td>
									<td>{{ hub.chip(entry.type) }}</td>
									<td><span class="status {{ entry.status }}" aria-hidden="true"></span>{{ entry.statuses()[entry.status] ?? entry.status }}</td>
									<td class="hub-num">{{ hub.num(relations) }}</td>
									<td>{{ hub.date(entry.postDate) }}</td>
									<td>{{ hub.date(entry.dateUpdated) }}</td>
									<td>{{ hub.review(reviews[entry.id], entry) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<footer class="hub-panel__footer">
					{% include '_includes/pagination' with {
						pageInfo: pageInfo,
						itemLabel: 'entry'|t('app'),
						itemsLabel: 'entries'|t('app'),
					} %}
				</footer>
			{% else %}
				<p class="hub-panel__empty">{{ 'Nothing matches the current filters.'|t('hub') }}</p>
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

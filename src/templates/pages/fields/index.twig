{% extends 'hub/_layouts/index' %}
{% import 'hub/_components/macros' as hub %}

{% set area = 'structure' %}
{% set page = 'fields' %}
{% set title = 'Fields'|t('hub') %}
{% set selectedTab = 'list' %}

{% set kindOptions = {} %}
{% for kind in enum_cases('SomehowDigital\\Craft\\Hub\\enums\\DataKind') %}
	{% set kindOptions = kindOptions|merge({ (kind.value): { label: kind.label(), icon: kind.icon(), color: kind.color() } }) %}
{% endfor %}

{% block content %}
	{{ hub.summary(summary) }}

	{% embed 'hub/_components/panel' %}
		{% block body %}
			{% import 'hub/_components/macros' as hub %}
			<form method="get" class="hub-filters" action="{{ url('hub/structure/fields') }}" data-hub-submit>
				{{ hub.search('Search by name or handle'|t('hub'), filter.search) }}
				{{ hub.dropdown('Field Type'|t('app'), 'puzzle-piece', hub.choices('type', types, filter.types)) }}
				{{ hub.dropdown('Relations'|t('hub'), 'link', hub.choices('owner', owners, filter.owners, { label: 'Placed in'|t('hub') })
					~ hub.range('layouts', 'Number of layouts'|t('hub'), filter.layoutsMin, filter.layoutsMax)) }}
				{{ hub.dropdown('Data'|t('hub'), 'database', hub.choices('kind', kindOptions, filter.kinds)) }}
				{{ hub.diagnosticsFilter(filter.diagnoses) }}
				{{ hub.toggle('unused', 'Unused only'|t('hub'), filter.unused) }}
				{{ hub.toggle('empty', 'Empty only'|t('hub'), filter.empty) }}
				{{ hub.clearFilters() }}
				{{ hiddenInput('sort', sort) }}
				{{ hiddenInput('dir', dir) }}
				<span class="hub-count">{{ '{count, plural, =1{One field} other{# fields}}'|t('hub', { count: pageInfo.total }) }}</span>
				{{ hub.columnPicker('fields', columns) }}
			</form>

			{% if fields|length %}
				<div class="hub-table">
					<table class="data fullwidth">
						<thead>
							<tr>
								{{ hub.sortHeader('Name'|t('app'), 'name', sortHeaders) }}
								{{ hub.columnHeaders(columns, sortHeaders) }}
							</tr>
						</thead>
						<tbody>
							{% for info in fields %}
								{% set field = info.field %}
								{% set fieldData = data[field.id] ?? null %}
								<tr{% if info.isUnused() %} data-severity="red"{% elseif info.isEmpty() %} data-severity="orange"{% endif %}>
									<th>{{ hub.name(field, info.dataKind.color()) }}</th>
									{% for column in columns %}
										<td{{ hub.cellAttributes(column) }}>
											{%- if not column.visible -%}
											{%- elseif column.key == 'type' -%}
												{{ info.typeName }}
											{%- elseif column.key == 'layouts' -%}
												{% if info.ownerTypes|length %}
													{{ hub.num(info.layouts|length) }}
													{% if info.instanceCount > info.layouts|length %}
														<span class="hub-muted" title="{{ 'Instances'|t('hub') }}">({{ info.instanceCount }})</span>
													{% endif %}
													<span class="hub-badges">
														{%- for owner in info.ownerTypes %}{{ hub.badge(owner) }}{% endfor -%}
													</span>
												{% else %}
													<span class="hub-muted">—</span>
												{% endif %}
											{%- elseif column.key == 'data' -%}
												{% if fieldData is not null %}
													{{ hub.num(fieldData) }}
													<span class="hub-muted">{{ info.isNested ? 'entries'|t('app') : 'references'|t('hub') }}</span>
												{% else %}
													<span class="hub-muted">—</span>
												{% endif %}
											{%- elseif column.key == 'status' -%}
												{{ hub.fieldStatus(info) }}
											{%- elseif column.key == 'diagnostics' -%}
												{{ hub.diagnostics(diagnostics[field.id], field) }}
											{%- endif -%}
										</td>
									{% endfor %}
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<footer class="hub-panel__footer">
					{% include '_includes/pagination' with {
						pageInfo: pageInfo,
						itemLabel: 'field'|t('hub'),
						itemsLabel: 'fields'|t('hub'),
					} %}
				</footer>
			{% else %}
				<p class="hub-panel__empty">{{ 'Nothing matches the current filters.'|t('hub') }}</p>
			{% endif %}
		{% endblock %}
	{% endembed %}
{% endblock %}

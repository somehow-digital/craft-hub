{% extends 'hub/_layouts/detail' %}
{% import 'hub/_components/macros' as hub %}

{% set field = info.field %}

{% set title = field.name|t('site') %}
{% set area = 'structure' %}
{% set selectedSubnavItem = 'fields' %}
{% set path = 'hub/structure/fields/' ~ field.id %}
{# Only nested entry fields have entries to list. #}
{% set listTabs = info.isNested ? [{ id: 'entries', label: 'Entries'|t('app') }] : [] %}
{% set statisticsTab = true %}
{% set crumbs = [
	{ label: 'Fields'|t('app'), url: url('hub/structure/fields', { hubSite: hubSite }) },
	{ label: title, url: url(path, { hubSite: hubSite }), current: true },
] %}

{% block pageTitle %}
	{{ hub.pageTitle(field, 'Field'|t('app'), hub.fieldType(field, info.dataKind.color(), info.dataKind.label()), info.dataKind.color()) }}
{% endblock %}

{% block actionButton %}
	<div class="flex">
		{{ hub.siteFilter() }}
		{% if currentUser.admin %}
			<a class="btn" href="{{ field.cpEditUrl }}">
				<span class="hub-btn-icon" aria-hidden="true">{{ iconSvg('pen') }}</span>
				<span>{{ 'Edit'|t('app') }}</span>
			</a>
		{% endif %}
	</div>
{% endblock %}

{% block details %}
	<dl class="meta read-only hub-details">
		{% include 'hub/_components/detail-labels' with { list: 'fields', id: field.id } only %}
		<div class="data">
			<dt class="heading">{{ 'Handle'|t('app') }}</dt>
			<dd class="value"><code>{{ field.handle }}</code></dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Data'|t('hub') }}</dt>
			<dd class="value">{{ hub.badge(info.dataKind.label(), info.dataKind.color(), null, info.dataKind.icon()) }}</dd>
		</div>
		{% if field.instructions %}
			<div class="data">
				<dt class="heading">{{ 'Instructions'|t('app') }}</dt>
				<dd class="value">{{ field.instructions }}</dd>
			</div>
		{% endif %}
		{% if info.isNested %}
			<div class="data">
				<dt class="heading">{{ 'URLs'|t('hub') }}</dt>
				<dd class="value">{% if info.hasUrls %}{{ hub.badge('Has URLs'|t('hub'), 'green', null, 'globe') }}{% else %}{{ hub.badge('No URLs'|t('hub')) }}{% endif %}</dd>
			</div>
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Translation Method'|t('app') }}</dt>
			<dd class="value">{{ hub.translationMethod(field.translationMethod) }}</dd>
		</div>
		<div class="data">
			<dt class="heading">{{ 'Searchable'|t('hub') }}</dt>
			<dd class="value">{{ field.searchable ? 'Yes'|t('app') : 'No'|t('app') }}</dd>
		</div>
		{% if field is instance of('craft\\fields\\BaseRelationField') %}
			{% if field.minRelations is not null %}
				<div class="data">
					<dt class="heading">{{ 'Min Relations'|t('app') }}</dt>
					<dd class="value">{{ field.minRelations|number }}</dd>
				</div>
			{% endif %}
			{% if field.maxRelations is not null %}
				<div class="data">
					<dt class="heading">{{ 'Max Relations'|t('app') }}</dt>
					<dd class="value">{{ field.maxRelations|number }}</dd>
				</div>
			{% endif %}
		{% endif %}
		<div class="data">
			<dt class="heading">{{ 'Status'|t('app') }}</dt>
			<dd class="value">{{ hub.fieldStatus(info) }}</dd>
		</div>
		{{ hub.identifiers(field) }}
	</dl>
{% endblock %}

{% block overview %}
	{% include 'hub/_panels/maintainers' with { list: 'fields', item: field, hubSite: hubSite } only %}

	{% if info.isNested %}
		{% include 'hub/_panels/fields/entry-types' with { info: info, field: field, siteIds: siteIds } only %}
	{% endif %}

	{% if info.sections|length %}
		{% include 'hub/_panels/fields/sections' with { info: info, field: field, siteIds: siteIds } only %}
	{% endif %}

	{% if volumes|length %}
		{% include 'hub/_panels/fields/volumes' with { volumes: volumes, field: field, siteIds: siteIds } only %}
	{% endif %}

	{% include 'hub/_panels/fields/relations' with { info: info } only %}

	{% if field is instance of('craft\\fields\\ContentBlock') %}
		{% include 'hub/_panels/field-layout' with { layout: field.getFieldLayout() } only %}
	{% endif %}

	{% include 'hub/_panels/activity' with { subject: 'field', id: field.id } only %}
{% endblock %}

{% block list %}
	{% include 'hub/_components/entry-list' with { list: list, hubSite: hubSite } only %}
{% endblock %}

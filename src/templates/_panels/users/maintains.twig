{#
	Panel with what a user maintains, themselves or through their groups, while they maintain anything. Its page counts
	them; loaded (see BaseController::renderPanel()), it lists them.

	Variables: count (see MaintainerService::countMaintainedBy()), or maintained (MaintainerSource[]) once loaded
#}
{% embed 'hub/_components/panel' with {
	heading: 'Maintains'|t('hub'),
	description: 'Sections, entry types, fields and volumes the user maintains, themselves or through their groups.'|t('hub'),
	icon: 'users',
	color: 'violet',
	count: (loaded ?? false) ? maintained|length : count,
	panelKey: 'maintains',
	loaded: loaded ?? false,
	maintained: maintained ?? null,
	hubSite: hubSite,
} only %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<div class="hub-table">
			<table class="data fullwidth">
				<thead>
					<tr>
						<th>{{ 'Name'|t('app') }}</th>
						<th>{{ 'Type'|t('app') }}</th>
						<th>{{ 'Maintained'|t('hub') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for source in maintained %}
						<tr>
							<th>{{ hub.chip(source.item) }}</th>
							<td>{{ source.getKind() }}</td>
							<td>
								<span class="hub-badges">
									{%- if source.users|length %}{{ hub.badge('Directly'|t('hub'), 'gray', null, 'user') }}{% endif -%}
									{%- for group in source.groups %}
										<a class="hub-badge" data-color="violet" href="{{ url('hub/data/users', {hubSite: hubSite, group: group.handle}) }}">{{ group.name|t('site') }}</a>
									{%- endfor -%}
								</span>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% endblock %}
{% endembed %}

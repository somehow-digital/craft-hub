{#
	Panel with the entry types of a section, with their entries in it. Loaded (see BaseController::renderPanel()), it lists
	them along with what they're used for, and counts their entries.

	Variables: info (SectionInfo), section, and once loaded entryTypes (EntryTypeInfo[] by their ID), statistics
	(StatisticsService)
#}
{% embed 'hub/_components/panel' with { heading: 'Entry Types'|t('hub'), icon: 'shapes', count: info.entryTypes|length, panelKey: 'entryTypes' } %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<div class="hub-table">
			<table class="data fullwidth">
				<thead>
					<tr>
						<th>{{ 'Name'|t('app') }}</th>
						<th>{{ 'Usage'|t('hub') }}</th>
						<th class="hub-num">{{ 'Entries in this section'|t('hub') }}</th>
						<th class="hub-num">{{ 'Drafts'|t('app') }}</th>
						<th>{{ 'Last updated'|t('hub') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for entryType in info.entryTypes %}
						{% set stats = statistics.sumEntries(siteIds, section.id, entryType.id) %}
						<tr{% if not stats.total %} data-severity="orange"{% endif %}>
							<th>{{ hub.name(entryType, null, not stats.total ? hub.noEntriesHere()) }}</th>
							<td>{{ hub.kinds(entryTypes[entryType.id].kinds ?? []) }}</td>
							<td class="hub-num">{{ hub.num(stats.total) }}</td>
							<td class="hub-num">{{ hub.num(stats.drafts) }}</td>
							<td>{{ hub.date(stats.lastUpdated) }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% endblock %}
{% endembed %}

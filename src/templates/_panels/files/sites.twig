{#
	Panel with the title, alternative text and status of a file on each of the counted sites. Its page counts them; loaded
	(see BaseController::renderPanel()), it lists them.

	Variables: isImage, count (see FileService::countSiteVariants()), or sites (Asset[]) once loaded
#}
{% embed 'hub/_components/panel' with {
	heading: 'Sites'|t('app'),
	description: 'Title and alternative text of the file on each site.'|t('hub'),
	icon: 'globe',
	count: (loaded ?? false) ? sites|length : count,
	panelKey: 'sites',
	loaded: loaded ?? false,
	sites: sites ?? null,
	isImage: isImage,
} only %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		<div class="hub-table">
			<table class="data fullwidth">
				<thead>
					<tr>
						<th>{{ 'Site'|t('app') }}</th>
						<th>{{ 'Title'|t('app') }}</th>
						<th>{{ 'Alternative Text'|t('app') }}</th>
						<th>{{ 'Status'|t('app') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for variant in sites %}
						<tr{% if isImage and not variant.alt|trim %} data-severity="orange"{% endif %}>
							<th>{{ variant.site.name|t('site') }}</th>
							<td>{{ variant.title }}</td>
							<td>{% if variant.alt|trim %}{{ variant.alt }}{% else %}<span class="hub-muted">—</span>{% endif %}</td>
							<td><span class="status {{ variant.status }}" aria-hidden="true"></span>{{ variant.statuses()[variant.status] ?? variant.status }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% endblock %}
{% endembed %}

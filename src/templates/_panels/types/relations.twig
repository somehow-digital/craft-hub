{#
	Panel with the sections and nested entry fields using an entry type, and the Entries and Link fields that can relate to
	its entries. Loaded (see BaseController::renderPanel()), it lists them, and counts their entries.

	Variables: info (EntryTypeInfo), entryType, and once loaded statistics (StatisticsService)
#}
{% embed 'hub/_components/panel' with {
	heading: 'Relations'|t('hub'),
	description: 'Sections and nested entry fields using this entry type, and Entries and Link fields that can relate to its entries.'|t('hub'),
	icon: 'link',
	color: 'teal',
	count: info.sections|length + info.relationCount,
	panelKey: 'relations',
} %}
	{% block body %}
		{% import 'hub/_components/macros' as hub %}
		{% set usageKind = enum('SomehowDigital\\Craft\\Hub\\enums\\UsageKind') %}
		{% if info.sections|length or info.relationCount %}
			<div class="hub-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'Name'|t('app') }}</th>
							<th>{{ 'Relation'|t('hub') }}</th>
							<th>{{ 'Type'|t('app') }}</th>
							<th class="hub-num">{{ 'Entries'|t('app') }}</th>
							<th>{{ 'Last updated'|t('hub') }}</th>
						</tr>
					</thead>
					<tbody>
						{% set kind = usageKind.from('section') %}
						{% for section in info.sections %}
							{% set stats = statistics.sumEntries(siteIds, section.id, entryType.id) %}
							<tr{% if not stats.total %} data-severity="orange"{% endif %}>
								<th>{{ hub.name(section, null, not stats.total ? hub.noEntriesHere()) }}</th>
								<td>{{ hub.badge(kind.label(), kind.color(), kind.description(), kind.icon()) }}</td>
								<td>{{ hub.sectionType(section) }}</td>
								<td class="hub-num">{{ hub.num(stats.total) }}</td>
								<td>{{ hub.date(stats.lastUpdated) }}</td>
							</tr>
						{% endfor %}
						{% set kind = usageKind.from('nested') %}
						{% for field in info.nestedFields %}
							{% set stats = statistics.sumEntries(siteIds, null, entryType.id, field.id) %}
							<tr{% if not stats.total %} data-severity="orange"{% endif %}>
								<th>{{ hub.name(field, 'violet', not stats.total ? hub.noEntriesHere()) }}</th>
								<td>{{ hub.badge(kind.label(), kind.color(), kind.description(), kind.icon()) }}</td>
								<td>{{ hub.fieldType(field, 'violet') }}</td>
								<td class="hub-num">{{ hub.num(stats.total) }}</td>
								<td>{{ hub.date(stats.lastUpdated) }}</td>
							</tr>
						{% endfor %}
						{% set kind = usageKind.from('reference') %}
						{% for field in info.referenceFields %}
							<tr>
								<th>{{ hub.name(field, 'teal') }}</th>
								<td>{{ hub.badge(kind.label(), kind.color(), kind.description(), kind.icon()) }}</td>
								<td>{{ hub.fieldType(field, 'teal') }}</td>
								<td></td>
								<td></td>
							</tr>
						{% endfor %}
						{% for field in info.linkFields %}
							<tr>
								<th>{{ hub.name(field, 'cyan') }}</th>
								<td>{{ hub.badge(kind.label(), kind.color(), 'Can be referenced through a Link field.'|t('hub'), kind.icon()) }}</td>
								<td>{{ hub.fieldType(field, 'cyan') }}</td>
								<td></td>
								<td></td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			{{ hub.emptyState('link-slash', 'This entry type is not used by any section or field.'|t('hub')) }}
		{% endif %}
	{% endblock %}
{% endembed %}
